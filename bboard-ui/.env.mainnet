VITE_NETWORK_ID=mainnet
VITE_LOGGING_LEVEL=warn

# The mainnet contract addresses are NOT set here. A mainnet build reads them from
# api/src/deploy-guard.ts (MAINNET_VEILCORE_ADDRESS, MAINNET_CLAIMS_ADDRESS) and refuses to
# build while the main one is empty. They are shown on the site only; the site sends no
# transactions. Deploy with `npm run deploy:mainnet` (docs/mainnet-day-site.md).
