VITE_NETWORK_ID=preprod
VITE_LOGGING_LEVEL=warn

# Real transactions from the website (docs/real-chain-plan.md) are OFF in this file and
# must stay off here: npm run build and deploy:prod read it. A real-chain build passes
# them in its own environment, never by editing this file:
#   VITE_REAL_CHAIN=1
#   VITE_REAL_CHAIN_CONTRACT_ADDRESS=<64 hex, the demo contract on preprod>
#   VITE_SPONSOR_URL=https://<the sponsor service>
