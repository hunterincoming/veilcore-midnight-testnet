// Veilcore Lineage — heritable rights for self-replicating assets.
// SPDX-License-Identifier: Apache-2.0
//
// Existing IP registries record objects: a patent, a work, a variety. Biological
// IP is not an object, it is a lineage — a cut becomes a mother becomes ten
// thousand clones, and every descendant carries a fractional claim from upstream.
// Nothing records rights that inherit.
//
// This contract does. It sits above the record commitments in veilcore.compact
// and references them by hash; it does not fork or replace that contract.
//
// STATE MODEL: bounded by design. Parentage is disclosed into the transaction and
// never written to a map — the graph is reconstructed from transaction history,
// exactly as anchors are. The only retained state is the encumbered set, which
// shrinks as obligations are discharged, so it is bounded by outstanding
// obligations rather than by cumulative usage.

pragma language_version 0.23;

import CompactStandardLibrary;

// Fixed single-slot fields.
export ledger descentSeq: Counter;
export ledger lastDescent: Bytes<32>;

// Records carrying an unmet obligation. Entries are removed on discharge, so the
// set is bounded by open obligations, not by how many records exist.
export ledger encumbered: Map<Bytes<32>, Bytes<32>>;

// The caller's private genetic secret, supplied by the wallet's private state.
witness localGeneticSecret(): Bytes<32>;

// Domain-separated commitment, matching veilcore.compact so hashes are comparable.
export circuit commit(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilcore:commit"), secret]);
}

// Declare that a record descends from a parent. The caller proves they hold the
// child's preimage; both commitments are disclosed into the transaction. No state
// is written — the edge lives in transaction history.
export circuit declareParent(childCommitment: Bytes<32>, parentCommitment: Bytes<32>): [] {
  assert(childCommitment == commit(localGeneticSecret()), "Only the record holder can declare its parentage");
  const c = disclose(childCommitment);
  const p = disclose(parentCommitment);
  descentSeq.increment(1);
  lastDescent = c;
}

// Attach an obligation to a record the caller owns — a breeder share, a royalty,
// a condition. The obligation itself stays off-chain; only its commitment is held.
export circuit encumber(recordCommitment: Bytes<32>, obligationCommitment: Bytes<32>): [] {
  assert(recordCommitment == commit(localGeneticSecret()), "Only the record holder can encumber it");
  const rc = disclose(recordCommitment);
  assert(!encumbered.member(rc), "Record is already encumbered");
  encumbered.insert(rc, disclose(obligationCommitment));
}

// Discharge an obligation. Only the party who attached it can release it, and the
// entry is removed so the set stays bounded.
export circuit discharge(recordCommitment: Bytes<32>): [] {
  assert(recordCommitment == commit(localGeneticSecret()), "Only the holder can discharge");
  const rc = disclose(recordCommitment);
  assert(encumbered.member(rc), "Record is not encumbered");
  encumbered.remove(rc);
}

// Public, privacy-safe check: is this record carrying an unmet obligation?
export circuit isEncumbered(recordCommitment: Bytes<32>): Boolean {
  return encumbered.member(disclose(recordCommitment));
}
