// Veilcore Lineage — heritable rights for self-replicating assets.
// SPDX-License-Identifier: Apache-2.0
//
// Biological IP is a lineage, not an object: a cut becomes a mother becomes ten
// thousand clones, and a claim made upstream should follow the material down. This
// contract records two things and nothing else:
//
//   DESCENT      child -> parent edges that BOTH holders agreed to.
//   OBLIGATIONS  claims against a record that BOTH the holder and the beneficiary
//                agreed to, and that only the beneficiary can release.
//
// A verifier walks confirmed edges in transaction history and requires a clean proof
// for every ancestor it finds. The walk is the verifier's, never the prover's: a
// pedigree handed over by the party who benefits from it is missing whatever was
// inconvenient.
//
// SECURITY PASS 30 SEP 2026. The previous design kept obligations in a depth-24
// sparse Merkle tree with slots derived from commitments, and let ANY party encumber
// ANY record. Confirmed against that build:
//
//   · anyone could encumber anyone. A competitor attached a claim to a stranger's
//     record, the record failed every clean proof from then on, and only the
//     competitor could release it. Poisoning a whole registry cost a fee per record.
//   · a squatter's leaf occupied the victim's slot, so the real licensor's royalty
//     could never be attached. Grinding a secret into a chosen slot took ~81 s.
//   · readers accepted any of the last 8 roots, so a seller could present a proof
//     prepared just before an encumbrance landed and defeat it.
//
// Obligations are now CONSENT-BASED (proposed by the beneficiary, accepted by the
// holder, released by the beneficiary) and stored in sets keyed by the full
// obligation, so there are no slots, no collisions, no grinding target and no stale
// roots: a clean proof reads the current state when it executes. The tree carried
// no privacy — encumbrances and clean proofs already published the record — so
// nothing is lost by dropping it, and the prover keys shrink from ~76 MB to a size
// a browser can load. Regression tests: contract/attack-lineage-30sep.mjs.
//
// STATE MODEL. Every container is cleared by the circuit that ends what filled it:
// pendingParentOf on confirm/withdraw, pendingObligations on accept/withdraw,
// openObligations and obligationCountOf on discharge. State is bounded by OPEN
// business — open proposals and unreleased obligations — never by cumulative usage.
//
// WHAT THIS CANNOT DO, AND THE VERIFIER RULE THAT COVERS IT.
//   · A party can anchor material under a fresh secret and get a record with no
//     history. Absence of a dirty ancestor is not evidence of a clean line; a
//     registry should require a confirmed path to an origin IT recognises.
//   · This contract cannot read the provenance contract, so it does not know about
//     rotation or recovery there. A commitment x is retired from the moment the
//     provenance contract's headOf(originFor(x)) != x; rotatedTo is NOT a complete
//     list (recovery does not write it). A verifier MUST replay the provenance
//     contract's rotation and recovery events (lastRotatedTo, lastRecoveredOrigin) to
//     learn when each commitment was retired, check obligations against EVERY
//     commitment in the identity, and ignore an edge confirmed, a proof made, or a
//     DISCHARGE made under a commitment after it was retired. Otherwise rotating a
//     secret sheds its obligations, and a thief holding a beneficiary's retired secret
//     can release what that beneficiary is owed. Current state alone cannot tell a
//     legitimate discharge from a thief's: a clean proof is only as good as the
//     verifier's replay of the discharges behind it.
//   · An edge means both holders said so, not that the child is biologically
//     descended from the parent. The DNA pairing in the provenance contract narrows
//     that; it does not close it.

pragma language_version 0.23;

import CompactStandardLibrary;

// ─────────────────────────────────────────────────────────────── state

export ledger descentSeq: Counter;
export ledger descentProposalSeq: Counter;
export ledger obligationSeq: Counter;
export ledger cleanProofSeq: Counter;

// Every event names its parties in a cell so the graph and the obligation set can be
// rebuilt from chain data by anyone, without the registry that made the calls.
export ledger lastDescent: Bytes<32>;
export ledger lastDescentChild: Bytes<32>;
export ledger lastDescentParent: Bytes<32>;
export ledger lastObligationRecord: Bytes<32>;
export ledger lastObligation: Bytes<32>;
export ledger lastBeneficiary: Bytes<32>;
export ledger lastCleanProofBy: Bytes<32>;
export ledger lastClearedAncestor: Bytes<32>;

/** Child -> the parent it proposed. Cleared on confirmation or withdrawal. */
export ledger pendingParentOf: Map<Bytes<32>, Bytes<32>>;

/** obligationKey(record, obligation, beneficiary) of proposals not yet accepted. */
export ledger pendingObligations: Set<Bytes<32>>;
/** obligationKey(...) of obligations in force. */
export ledger openObligations: Set<Bytes<32>>;
/** Record -> how many obligations are in force against it. Absent means none. */
export ledger obligationCountOf: Map<Bytes<32>, Uint<32>>;

/** The caller's record secret: a child, a parent, a holder or a beneficiary. */
witness localGeneticSecret(): Bytes<32>;

// ─────────────────────────────────────────────────────────────── pure

export circuit commit(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilcore:commit"), secret]);
}

export circuit descentEdge(child: Bytes<32>, parent: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:descent"), child, parent]);
}

/** One obligation: on which record, what it is, and who it is owed to. */
export circuit obligationKey(
  recordCommitment: Bytes<32>,
  obligationCommitment: Bytes<32>,
  beneficiaryCommitment: Bytes<32>,
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "veilcore:obligation"), recordCommitment, obligationCommitment, beneficiaryCommitment,
  ]);
}

// ─────────────────────────────────────────────────────────────── caller

/**
 * The caller's record, DERIVED from their secret. Never an argument: a circuit that
 * takes the caller's identity as an argument is safe only for as long as nobody
 * edits away the comparison that checks it.
 */
circuit self(): Bytes<32> {
  return disclose(commit(localGeneticSecret()));
}

// ─────────────────────────────────────────────────────────────── descent

/**
 * The child's holder names a parent. An offer, not an edge: nothing is established
 * until the parent's holder confirms. One live proposal per child, so a cross is two
 * rounds.
 */
export circuit proposeParent(parentCommitment: Bytes<32>): [] {
  const c = self();
  const p = disclose(parentCommitment);
  assert(p != default<Bytes<32>>, "The parent cannot be empty");
  assert(c != p, "A record is not its own parent");
  assert(!pendingParentOf.member(c), "This record already has a parentage proposal outstanding");
  descentProposalSeq.increment(1);
  pendingParentOf.insert(c, p);
}

/**
 * The parent's holder accepts being named, for a SPECIFIC child. The stored proposal
 * must still name the caller, so a child who re-proposes elsewhere between the
 * parent's decision and this transaction gets a refusal, not an edge.
 *
 * A record whose parent has no holder (a landrace, a lapsed breeder) can never have
 * that edge confirmed. That is the price of an edge meaning both parties agreed.
 */
export circuit confirmParent(childCommitment: Bytes<32>): [] {
  const p = self();
  const c = disclose(childCommitment);
  assert(pendingParentOf.member(c), "No parentage proposed for that record");
  assert(pendingParentOf.lookup(c) == p, "You are not the parent proposed for this record");
  pendingParentOf.remove(c);
  descentSeq.increment(1);
  lastDescent = descentEdge(c, p);
  lastDescentChild = c;
  lastDescentParent = p;
}

/** The child's holder retracts their own proposal. */
export circuit withdrawParent(): [] {
  const c = self();
  assert(pendingParentOf.member(c), "No parentage proposed for your record");
  descentProposalSeq.increment(1);
  pendingParentOf.remove(c);
}

// ─────────────────────────────────────────────────────────────── obligations

/**
 * The BENEFICIARY proposes a claim against a record. It binds nobody until the
 * record's holder accepts it.
 *
 * Unilateral encumbrance is what let a stranger poison any record. A claim the
 * holder never agreed to is a dispute, and disputes belong off chain; what goes on
 * chain is an obligation both parties signed, the same shape as a licence and its
 * countersignature. The holder's leverage to refuse is real, and so is the
 * beneficiary's: they confirm parentage (and sell material) only once it is accepted.
 */
export circuit proposeObligation(recordCommitment: Bytes<32>, obligationCommitment: Bytes<32>): [] {
  const b = self();
  const r = disclose(recordCommitment);
  const o = disclose(obligationCommitment);
  assert(r != default<Bytes<32>>, "The record cannot be empty");
  assert(o != default<Bytes<32>>, "The obligation cannot be empty");
  assert(r != b, "A record cannot owe itself");
  const k = obligationKey(r, o, b);
  assert(!pendingObligations.member(k), "That obligation is already proposed");
  assert(!openObligations.member(k), "That obligation is already in force");
  pendingObligations.insert(k);
}

/** The beneficiary retracts a proposal the holder has not accepted. */
export circuit withdrawObligation(recordCommitment: Bytes<32>, obligationCommitment: Bytes<32>): [] {
  const k = obligationKey(disclose(recordCommitment), disclose(obligationCommitment), self());
  assert(pendingObligations.member(k), "No such proposal from you");
  pendingObligations.remove(k);
}

/**
 * The record's holder accepts a proposed obligation, naming the beneficiary they
 * agreed with. From here only the beneficiary can release it.
 */
export circuit acceptObligation(obligationCommitment: Bytes<32>, beneficiaryCommitment: Bytes<32>): [] {
  const r = self();
  const o = disclose(obligationCommitment);
  const b = disclose(beneficiaryCommitment);
  const k = obligationKey(r, o, b);
  assert(pendingObligations.member(k), "No such obligation proposed against your record");
  pendingObligations.remove(k);
  openObligations.insert(k);
  const n = obligationCountOf.member(r) ? obligationCountOf.lookup(r) : 0 as Uint<32>;
  obligationCountOf.insert(r, (n + 1) as Uint<32>);
  obligationSeq.increment(1);
  lastObligationRecord = r;
  lastObligation = o;
  lastBeneficiary = b;
}

/** ONLY THE BENEFICIARY releases an obligation. Being released is their decision. */
export circuit discharge(recordCommitment: Bytes<32>, obligationCommitment: Bytes<32>): [] {
  const b = self();
  const r = disclose(recordCommitment);
  const o = disclose(obligationCommitment);
  const k = obligationKey(r, o, b);
  assert(openObligations.member(k), "No such obligation in your favour");
  openObligations.remove(k);
  const n = obligationCountOf.lookup(r);
  if (n == 1) {
    obligationCountOf.remove(r);
  } else {
    obligationCountOf.insert(r, (n - 1) as Uint<32>);
  }
  obligationSeq.increment(1);
  lastObligationRecord = r;
  lastObligation = o;
  lastBeneficiary = b;
}

// ─────────────────────────────────────────────────────────────── clean proofs

/**
 * Prove one ancestor carries no obligation in force, as of this transaction.
 *
 * The ancestor is public: a clean proof with no subject cannot be joined to the
 * descent graph, and a hidden subject let a caller whose real parent was encumbered
 * prove any clean record instead. The caller is named too, so the proof is a
 * statement somebody made. It reads the CURRENT set when it executes: there is no
 * window in which a proof prepared before an encumbrance still passes after it.
 *
 * It does not prove the ancestor is the caller's ancestor. That join is the
 * verifier's, over confirmed edges, and so is resolving rotations (header).
 */
export circuit proveAncestorClean(ancestorCommitment: Bytes<32>): [] {
  const me = self();
  const a = disclose(ancestorCommitment);
  assert(a != default<Bytes<32>>, "The ancestor cannot be empty");
  assert(me != a, "A record is not its own ancestor");
  assert(!obligationCountOf.member(a), "This ancestor carries an unmet obligation");
  cleanProofSeq.increment(1);
  lastCleanProofBy = me;
  lastClearedAncestor = a;
}
