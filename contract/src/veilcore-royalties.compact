// VeilCore royalties: licences sold from an offer; royalties prepaid in public, settled in private.
// SPDX-License-Identifier: Apache-2.0
//
// PUBLIC MONEY, PRIVATE BOOKS. Money only ever moves in two places, both public, both
// passed straight through in one call (the contract holds nothing): buying a licence, and
// topping up royalty credit. It goes to the breeder, and to the variety's ancestors when
// it has any (OFFSPRING below). Settling a period's royalty against that credit
// moves no money, and publishes nothing that says which offer, which licensee, which
// period, how many units or at what rate. The breeder reads all of that for their own
// licensees with each licensee's viewing key. A buyer, processor or regulator checks
// "live licence, royalty settled for this period, at least N units" with a presentation.
//
// OFFER. A breeder posts an offer against a record: a fingerprint of the terms, a price,
// a commitment to the royalty rate (the rate itself is in the terms, with its salt), the
// token, the payout wallet, how many licences are for sale, when they end, and whether
// they can be revoked. A rate commitment must open to a rate above zero when posted. The
// offer is run by its own admin key. Sales are counted in counters (soldOf, liveOf), so two
// buyers at once never conflict over the offer. Each offer is also a leaf of
// `offerLeaves`, so a top-up or settlement can prove its offer without naming it.
//
// LICENCE. A licensee holds a secret s for each licence, and from it, for that offer only,
// a spending key and a viewing key (spendKey(s, offer), viewKey(s, offer)); the keys of
// one secret on two offers share nothing a breeder could match. The licence commits to
// both keys and the offer. The licensee gives the breeder a licence card (the licence
// key, viewing key and spending key) with the signed terms: the breeder checks it against
// the sale on chain and can then read that licence's settlements, but can never spend
// its credit, settle, or present it. The viewing key is made from a PRESENTATION key
// (presentKey(s, offer)), which proves the licence and its settlements but never spends:
// a seed company can hand it to the growers who answer buyers, and keep s.
//
// CREDIT. A top-up pays an amount to the offer's payout wallet and creates a credit note
// worth that amount, bound to the offer's leaf (its id and every term, the rate included),
// from a top-up code the licensee gives the payer (topUpCode(spendKey, nonce)). The payer
// knows which offer they are paying for; the public sees the paying wallet, the breeder's
// wallet, the token, the amount and a rounded time the offer is open until (clients always
// send the start of the day after tomorrow, UTC; top-ups run until 30 days after the offer
// ends, so its last season can be paid for, and clients stop them two days before that),
// and not which of that wallet's royalty offers in that token it is, nor the
// licensee (except for an offer whose ancestors take a share: see OFFSPRING). A breeder
// with a single royalty offer per wallet and token has no such cover. Each note has its own
// nullifier, so a code reused for top-ups of different amounts makes several spendable
// notes (the same code, offer and amount twice is refused before anything is paid). The
// payer opens the rate too, so no credit is ever sold that nothing could settle against.
//
// SETTLEMENT. Needs the licence in the licence tree (a revocation takes effect at the
// next seal, as for presentations). The licensee spends a note (its nullifier is
// unlinkable to the note without the licensee's key), proves units x rate <= its value
// against the offer's rate commitment (a zero rate is refused), keeps the change as a
// new note whose nonce comes from the spent note's nullifier, and records a receipt leaf
// bound to the offer, the period (through the viewing key), the units and the change note
// (so no two settlements share a receipt). Each settlement of a licence is numbered
// (settleTag(viewKey, n), unique), so the breeder looks its settlements up directly and
// sees a skipped number. It publishes
// the units masked with a pad made from the viewing key and the change note, so no two
// settlements share a pad and only the breeder reads them; every settlement is kept in
// `settlements`, so none is missed. Settling is allowed for at least 30 days after the
// offer ends (it moves no money; nobody can clear the licence sooner, and a licence cannot
// be revoked after its end, so those 30 days cannot be cut short). Credit left when a licence ends or is
// revoked stays where it is: the breeder already holds that money, and the terms say
// whether any is refunded.
//
// PRESENTATION. One verifier, one offer, live at a time the verifier names (the end date
// is read once and checked against both that time and the licence leaf), and
// optionally a settlement for a period covering at least minUnits; or, asked about a
// period without `live`, a settlement under a licence the chain still holds even if it
// has ended (its last season). Made with the presentation key and the public spending
// key, never the licence secret. Publishes a tag only
// that verifier can check and a holder tag that repeats only within the verifier's scope.
// It proves that SOMEONE holding that licence answered, not that the person in front of
// the verifier holds it: a licensee could answer for another grower. A verifier that
// keeps one scope sees the same holder tag each time one licence answers it. Revocations
// are tracked per offer, so a verifier waits only for a seal after a revocation on the
// offer it asked about.
//
// OFFSPRING (protocol 3). A new variety's breeder proposes a descent link to a parent
// record with exact terms (a fee per licence, a share of licence prices and royalty
// top-ups, how many generations it follows, an end date, a token, a payee); the parent
// confirms those exact terms, after its own ancestors are final. The child can never change
// them; the parent's payee key can move where they are paid or LOWER them, at most once in
// 30 days (so it cannot stall descendants' sales at will). The child makes its ancestors
// final once, naming every confirmed link (none can be left out), as a pedigree chart of
// link ids in fixed places: 2 parents, 4 grandparents, 8 great-grandparents, each place
// carried from the parent's chart only while its link still runs that far. A share is
// paid in full to a parent, half to a grandparent, a quarter to a great-grandparent,
// rounded down; all shares together are capped at half, checked when each link is
// confirmed; all must be owed in one token, also checked then. Every licence sale pays
// each share and each parent's fee in the same call. An offer whose ancestors take a
// royalty share must take royalties through the contract, and is topped up through
// topUpSplit, which NAMES the offer (which variety, how much); others keep the private
// topUp. Settling and presenting are unchanged. Declaring parents is not enforced here:
// clients check each chart against the main contract's confirmed parents
// (docs/royalties-offspring-design.md).
//
// ONE RECORD, TWO CONTRACTS. The breeder proves the record by its secret, hashed exactly
// as veilcore.compact's commit() hashes it. Whether that record is the live head of an
// anchored identity is read from veilcore.compact off chain (ledger 8 has no calls
// between contracts). An offer id is never reused. REVOCATION follows veilcore.compact.
// SEALS: a seal retires the licence tree's old roots only when a revocation is waiting, and
// every tree's at most daily (to bound history), so nobody can void proofs in flight at will.
//
// WHAT CAN STILL LINK. Every root a proof uses is public. A chain of them can link a
// presentation to a settlement, a settlement to the top-up that made its note, and the
// top-up to its paying wallet, when few others used the contract in between; and a
// licensee who tops up from the wallet that bought the licence links the two. Clients
// wait for someone else's transaction before proving, which helps only as much as there
// are others; privacy grows with use. Also public: which circuit each transaction calls
// (whether the DUST fee payment can be tied to a wallet is not stated in Midnight's docs:
// to be confirmed before relying on it); whether a presentation asked about a period; the time the
// verifier asked for; equal holder tags; that a merge spent two notes of one owner; top-up
// amounts (unrounded ones can hint at the rate); and a refused proof tells a verifier
// something about the units. Units are declared by the licensee; checking them against
// harvests happens off chain, by the breeder, who can read them.

pragma language_version 0.23;

import CompactStandardLibrary;

/** One offer. Everything in it is public; the rate is only committed to. */
export struct Offer {
  record: Bytes<32>,
  admin: Bytes<32>,
  terms: Bytes<32>,
  color: Bytes<32>,
  price: Uint<64>,
  /** rateCommit(rate, salt); all zero for an offer that takes no royalties through the contract. */
  rateCommit: Bytes<32>,
  payTo: UserAddress,
  /** How many licences were offered. Sold and live counts are counters (soldOf, liveOf), so sales never conflict. */
  count: Uint<32>,
  expires: Uint<64>,
  revocable: Boolean,
  open: Boolean,
  /** Whether the record's ancestors take a share of royalties: then top-ups go through topUpSplit, which names the offer. */
  split: Boolean,
}

/** What a top-up or settlement knows about its offer, privately. */
export struct OfferOpening {
  offer: Bytes<32>,
  payTo: Bytes<32>,
  color: Bytes<32>,
  rateCommit: Bytes<32>,
  expires: Uint<64>,
  split: Boolean,
}

/** The token a chart's shares are owed in, once one is known. */
export struct ShareToken {
  known: Boolean,
  color: Bytes<32>,
}

/**
 * A descent link: the terms a child variety owes a parent variety, proposed by the
 * child's holder and confirmed by the parent's. Never changed once confirmed, never
 * removed. Only the payee key may move where it is paid.
 */
export struct Link {
  child: Bytes<32>,
  parent: Bytes<32>,
  /** The token the fee and share are paid in. */
  color: Bytes<32>,
  /** Paid per licence the child sells, to a direct parent only. */
  fee: Uint<64>,
  /** Basis points of the child's licence price and royalty top-ups; halves with each generation further. */
  share: Uint<16>,
  /** How many generations the share follows, 1 to 3. */
  generations: Uint<8>,
  until: Uint<64>,
  payTo: UserAddress,
  /** payeeCommit(secret) of the key that may move payTo, or lower (never raise) the terms. */
  payee: Bytes<32>,
  confirmed: Boolean,
  /** When the payee key last changed the link: at most once every 30 days, so it cannot block descendants' sales at will. */
  changedAt: Uint<64>,
}

/** A credit note's private half. */
export struct NoteOpening {
  nonce: Bytes<32>,
  amount: Uint<64>,
}

/** One settlement, kept for the breeder: its receipt leaf and its units masked for the viewing key. */
export struct Settlement {
  receipt: Bytes<32>,
  unitsMasked: Field,
  /** settleTag(viewKey, n) for the licence's n-th settlement: the breeder finds its own without scanning everything. */
  tag: Bytes<32>,
}

/** The royalty rate and the salt its commitment hides it with (both in the terms). */
export struct RateOpening {
  rate: Uint<64>,
  salt: Bytes<32>,
}

// ─────────────────────────────────────────────────────────────── state

/** Protocol version 3. Hash tags read "veilcore:royalties:v2:..." where unchanged since version 2, "v3" where new or changed. */
export sealed ledger protocolVersion: Uint<16>;

export ledger offers: Map<Bytes<32>, Offer>;
/** Every offer id ever posted, so an id is never reused with other terms. */
export ledger everPosted: Set<Bytes<32>>;
/** Depth 32: posting is free, so the tree must never fill (about 4 billion offers). */
export ledger offerLeaves: HistoricMerkleTree<32, Bytes<32>>;
/** Per offer: licences sold, and licences live (sold, not revoked or cleared). Counters, so concurrent sales never conflict. */
export ledger soldOf: Map<Bytes<32>, Counter>;
export ledger liveOf: Map<Bytes<32>, Counter>;
export ledger licenseOffer: Map<Bytes<32>, Bytes<32>>;
export ledger everSold: Set<Bytes<32>>;
export ledger licenses: HistoricMerkleTree<24, Bytes<32>>;
export ledger licenseSlotOf: Map<Bytes<32>, Uint<64>>;
export ledger licenseAtSlot: Map<Uint<64>, Bytes<32>>;
/** Credit notes, spent by nullifier. */
export ledger notes: HistoricMerkleTree<32, Bytes<32>>;
export ledger noteSeen: Set<Bytes<32>>;
export ledger nullifiers: Set<Bytes<32>>;
/** Settlement receipts, each unique (it includes the settlement's change note). Never removed. */
export ledger receipts: HistoricMerkleTree<32, Bytes<32>>;
/** settleTag -> the settlement's change note, so a breeder looks up its licensees' settlements directly. */
export ledger settlementByTag: Map<Bytes<32>, Bytes<32>>;
/**
 * Every settlement, keyed by its change note (unique, already public): the breeder scans
 * this with each licensee's viewing key. Kept per settlement, not in a "last" cell, so two
 * settlements in one transaction are both readable.
 */
export ledger settlements: Map<Bytes<32>, Settlement>;
/**
 * Per offer: the revocation count when one of its licences was last revoked. Kept after
 * the offer is removed, so a removal never hides a revocation from a verifier. A verifier
 * checks only the offer it asked about, so revocations on other offers (or spam on an
 * attacker's own offer) never hold up its presentations.
 */
export ledger offerRevokedAt: Map<Bytes<32>, Uint<64>>;
/** The revocation count at the last seal: an offer's revocations are sealed once offerRevokedAt <= this. */
export ledger sealedRevocations: Uint<64>;

/** Descent links, by linkId(child, parent). */
export ledger links: Map<Bytes<32>, Link>;
/**
 * A record's ancestors, as a pedigree chart of link ids: positions 0-1 its own links
 * (parents), 2-5 its parents' links (grandparents), 6-13 their parents' links. A link
 * appears only while it still has generations to run at that depth; an empty place is
 * all zero. Set once (finaliseStack or adoptStack), never changed or removed.
 */
export ledger stacks: Map<Bytes<32>, Vector<14, Bytes<32>>>;
/** Child record -> links confirmed for it (at most 2). */
export ledger linksConfirmed: Map<Bytes<32>, Uint<8>>;
/** Child record -> links proposed and not yet confirmed or withdrawn (at most 4). */
export ledger linksPending: Map<Bytes<32>, Uint<8>>;
/** Child record -> its confirmed links' shares, inherited ones included, in quarter basis points (cap 5000 x 4). */
export ledger linkWeight: Map<Bytes<32>, Uint<32>>;
/** Child record -> the token every share in its chart is owed in (set by the first link that brings one). */
export ledger shareTokenOf: Map<Bytes<32>, Bytes<32>>;
export ledger linkSeq: Counter;
export ledger lastLink: Bytes<32>;

export ledger lastSealTime: Uint<64>;
/** When the trees that only grow (offers, notes, receipts) last had their old roots retired. */
export ledger lastSlowSealTime: Uint<64>;
export ledger unsealedChanges: Boolean;
export ledger rootsSinceSeal: Boolean;

export ledger saleSeq: Counter;
export ledger topUpSeq: Counter;
export ledger settleSeq: Counter;
export ledger revocationSeq: Counter;
export ledger sealSeq: Counter;
export ledger presentationSeq: Counter;

export ledger lastOffer: Bytes<32>;
export ledger lastSale: Bytes<32>;
export ledger lastNote: Bytes<32>;
export ledger lastNullifier: Bytes<32>;
export ledger lastReceipt: Bytes<32>;
export ledger lastPresentation: Bytes<32>;
export ledger lastPresentationHolder: Bytes<32>;
export ledger lastPresentationRoot: MerkleTreeDigest;
export ledger lastPresentationReceiptRoot: MerkleTreeDigest;

constructor() {
  protocolVersion = 3;
}

witness recordSecret(): Bytes<32>;
witness adminSecret(): Bytes<32>;
witness licenseSecret(): Bytes<32>;
witness licensePath(): MerkleTreePath<24, Bytes<32>>;
witness presentationOffer(): Bytes<32>;
/** The licence's end date (it is part of the licence leaf). */
witness licenceExpires(): Uint<64>;
witness presentationChallenge(): Bytes<32>;
witness receiptUnits(): Uint<64>;
witness receiptPath(): MerkleTreePath<32, Bytes<32>>;
witness offerOpening(): OfferOpening;
witness offerPath(): MerkleTreePath<32, Bytes<32>>;
witness topUpCodeWitness(): Bytes<32>;
witness noteOpening(): NoteOpening;
witness notePath(): MerkleTreePath<32, Bytes<32>>;
witness secondNoteOpening(): NoteOpening;
witness secondNotePath(): MerkleTreePath<32, Bytes<32>>;
witness rateOpening(): RateOpening;
witness settlePeriod(): Bytes<32>;
witness settleUnits(): Uint<64>;
/** For a split payment: each place's amount, worked out by the client and checked here. */
witness splitAmounts(): Vector<14, Uint<64>>;
/** A presentation needs only these (not the licence secret): presentKey and the public spending key. */
witness presentationKey(): Bytes<32>;
witness licenceSpendKey(): Bytes<32>;
/** The change note of the settlement a presentation shows (part of its receipt). */
witness receiptChange(): Bytes<32>;
/** Which settlement of this licence this is (0, 1, 2 ...): makes the breeder's scan tag. */
witness settleIndex(): Uint<64>;

circuit SEAL_INTERVAL(): Uint<64> { return 600; }
circuit SEAL_SLACK(): Uint<64> { return 300; }
/** Trees that only grow have old roots retired at most daily, only to bound their history. */
circuit SLOW_SEAL_INTERVAL(): Uint<64> { return 86400; }
circuit LICENSE_SLOTS(): Uint<64> { return 16777216; }
/** How long after an offer ends its licensees can still settle, before anyone may clear them. */
circuit SETTLE_GRACE(): Uint<64> { return 2592000; }
/** Ancestors take at most half: 5000 basis points, counted in quarter basis points. */
circuit MAX_LINK_WEIGHT(): Uint<32> { return 20000; }
circuit MAX_LINKS(): Uint<8> { return 2; }
circuit MAX_PENDING_LINKS(): Uint<8> { return 4; }
/** How often a link's payee key may change it. */
circuit PAYEE_CHANGE_INTERVAL(): Uint<64> { return 2592000; }
/** End dates stay far below 2^64, so end + grace never overflows. */
circuit MAX_TIME(): Uint<64> { return 4611686018427387904; }

// ─────────────────────────────────────────────────────────────── hashes

circuit u64(x: Uint<64>): Bytes<32> { return (x as Field) as Bytes<32>; }

/** Exactly veilcore.compact's commit(): the record a secret stands for. */
export circuit recordCommit(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilcore:v1:commit"), secret]);
}

export circuit adminCommit(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilcore:royalties:v2:admin"), secret]);
}

export circuit offerId(record: Bytes<32>, nonce: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:royalties:v2:offer"), record, nonce]);
}

/** The licensee's spending key for one offer: on the licence card, never enough to spend. */
export circuit spendKey(secret: Bytes<32>, offer: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:royalties:v2:spend"), secret, offer]);
}

/**
 * The licensee's presentation key for one offer: enough to PROVE the licence (and its
 * settlements) to a verifier, never enough to spend credit or settle. A seed company can
 * hand it to the growers who answer buyers, and keep the licence secret.
 */
export circuit presentKey(secret: Bytes<32>, offer: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:royalties:v3:present"), secret, offer]);
}

/** The viewing key made from a presentation key. */
export circuit viewOf(present: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilcore:royalties:v3:view"), present]);
}

/** The licensee's viewing key for one offer: lets that breeder read these settlements, nothing more. */
export circuit viewKey(secret: Bytes<32>, offer: Bytes<32>): Bytes<32> {
  return viewOf(presentKey(secret, offer));
}

/** The key that makes nullifiers. Never leaves the licensee. */
export circuit nullifierKey(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilcore:royalties:v2:nk"), secret]);
}

export circuit licenseCommit(view: Bytes<32>, spend: Bytes<32>, offer: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "veilcore:royalties:v2:license"), view, spend, offer]);
}

export circuit licenseKey(licenseCommitment: Bytes<32>, offer: Bytes<32>, expires: Uint<64>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "veilcore:royalties:v2:lickey"), licenseCommitment, offer, u64(expires),
  ]);
}

/** The commitment an offer publishes to its royalty rate. The salt keeps a small rate unguessable. */
export circuit rateCommit(rate: Uint<64>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:royalties:v2:rate"), u64(rate), salt]);
}

export circuit offerLeaf(offer: Bytes<32>, payTo: Bytes<32>, color: Bytes<32>, rate: Bytes<32>,
                         expires: Uint<64>, split: Boolean): Bytes<32> {
  return persistentHash<Vector<7, Bytes<32>>>([
    pad(32, "veilcore:royalties:v3:offerleaf"), offer, payTo, color, rate, u64(expires),
    u64(split ? 1 : 0),
  ]);
}

circuit leafOf(op: OfferOpening): Bytes<32> {
  return offerLeaf(op.offer, op.payTo, op.color, op.rateCommit, op.expires, op.split);
}

/** The id of the link from a child record to a parent record. */
export circuit linkId(child: Bytes<32>, parent: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:royalties:v3:link"), child, parent]);
}

/** Every term of a link, as the parent's confirmation names them: confirming binds exactly these. */
export circuit linkTermsHash(color: Bytes<32>, fee: Uint<64>, share: Uint<16>, generations: Uint<8>,
                             until: Uint<64>, payTo: Bytes<32>, payee: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<8, Bytes<32>>>([
    pad(32, "veilcore:royalties:v3:terms"), color, u64(fee), u64(share as Uint<64>), u64(generations as Uint<64>),
    u64(until), payTo, payee,
  ]);
}

/** The key that may move a link's payee. */
export circuit payeeCommit(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilcore:royalties:v3:payee"), secret]);
}

/** What a licensee hands whoever tops up their credit: it names neither the licensee nor the offer. */
export circuit topUpCode(spend: Bytes<32>, nonce: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:royalties:v2:code"), spend, nonce]);
}

/** A credit note: the code, the offer's leaf (its id and every term, rate included) and the amount. */
export circuit noteCommit(code: Bytes<32>, offerLeaf: Bytes<32>, amount: Uint<64>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "veilcore:royalties:v2:note"), code, offerLeaf, u64(amount)]);
}

/** Published when a note is spent: one per note, unlinkable to it without the licensee's key. */
export circuit nullifier(nk: Bytes<32>, note: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:royalties:v2:nullifier"), nk, note]);
}

/** The nonce of the change note a spend makes: unique, because the nullifier it follows is. */
export circuit changeNonceFor(secret: Bytes<32>, spent: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:royalties:v2:change"), secret, spent]);
}

export circuit receiptCommit(view: Bytes<32>, period: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:royalties:v2:receipt"), view, period]);
}

/** A receipt: one per settlement (its change note makes it unique), so two settlements never share one. */
export circuit receiptLeaf(commitment: Bytes<32>, offer: Bytes<32>, units: Uint<64>, change: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "veilcore:royalties:v3:paid"), commitment, offer, u64(units), change,
  ]);
}

/** The breeder's lookup tag for a licence's n-th settlement. */
export circuit settleTag(view: Bytes<32>, n: Uint<64>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:royalties:v3:settletag"), view, u64(n)]);
}

/**
 * The pad that masks a settlement's units: the viewing key and the settlement's own change
 * note (public, and never the same twice), so no two settlements share a pad.
 */
export circuit unitsMask(view: Bytes<32>, changeNote: Bytes<32>): Field {
  return degradeToTransient(
    persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:royalties:v2:mask"), view, changeNote]),
  );
}

/** What a verifier checks: every term of its request, including whether it asked for a licence live at validAt. */
export circuit presentationTag(offer: Bytes<32>, period: Bytes<32>, minUnits: Uint<64>, validAt: Uint<64>,
                               scope: Bytes<32>, challenge: Bytes<32>, live: Boolean): Bytes<32> {
  return persistentHash<Vector<8, Bytes<32>>>([
    pad(32, "veilcore:royalties:v3:presenttag"), offer, period, u64(minUnits), u64(validAt), scope, challenge,
    u64(live ? 1 : 0),
  ]);
}

export circuit holderTag(present: Bytes<32>, offer: Bytes<32>, scope: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "veilcore:royalties:v3:holder"), present, offer, scope]);
}

// ─────────────────────────────────────────────────────────────── helpers

circuit anyOffer(id: Bytes<32>): Offer {
  assert(offers.member(id), "No such offer");
  return offers.lookup(id);
}

circuit assertBefore(expires: Uint<64>): [] {
  assert(blockTimeLt(expires), "The licences from that offer have ended");
}

circuit assertAdmin(o: Offer): [] {
  assert(disclose(adminCommit(adminSecret()) == o.admin), "Only the offer's admin can do this");
}

circuit passThrough(color: Bytes<32>, amount: Uint<128>, to: UserAddress): [] {
  receiveUnshielded(color, amount);
  sendUnshielded(color, amount, right<ContractAddress, UserAddress>(to));
}

// ─────────────────────────────────────────────────────────────── descent helpers

circuit noLink(): Bytes<32> { return default<Bytes<32>>; }

/** A link's share in basis points while it runs, or 0 for an empty place or an ended link. */
circuit shareAt(id: Bytes<32>): Uint<16> {
  if (id == noLink()) {
    return 0;
  }
  const l = links.lookup(id);
  if (blockTimeLt(l.until)) {
    return l.share;
  }
  return 0;
}

circuit unknownToken(): ShareToken { return ShareToken { known: false, color: default<Bytes<32>> }; }

/** Add one share's token to what is known: all shares in a chart must be owed in one token. */
circuit withToken(t: ShareToken, hasShare: Boolean, color: Bytes<32>): ShareToken {
  if (!hasShare) {
    return t;
  }
  assert(!t.known || t.color == color,
         "This link's shares would be owed in two tokens: no offer could ever be posted. Agree one token");
  return ShareToken { known: true, color: color };
}

/** The token of a carried place's share, folded into `t`. */
circuit withCarried(t: ShareToken, id: Bytes<32>, minGenerations: Uint<8>): ShareToken {
  if (carried(id, minGenerations) == noLink()) {
    return t;
  }
  return withToken(t, shareAt(id) > 0, links.lookup(id).color);
}

/** A place in a parent's chart, carried one generation further only if its link still runs there. */
circuit carried(id: Bytes<32>, minGenerations: Uint<8>): Bytes<32> {
  if (id == noLink()) {
    return noLink();
  }
  if (links.lookup(id).generations >= minGenerations) {
    return id;
  }
  return noLink();
}

/** A carried place's weight, in quarter basis points (one generation further halves it). */
circuit carriedWeight(id: Bytes<32>, minGenerations: Uint<8>, quarters: Uint<8>): Uint<32> {
  if (carried(id, minGenerations) == noLink()) {
    return 0;
  }
  return (shareAt(id) * quarters) as Uint<32>;
}

/** What a child inherits through a link to this parent's chart, in quarter basis points. */
circuit inheritedWeight(st: Vector<14, Bytes<32>>): Uint<32> {
  return (carriedWeight(st[0], 2, 2) + carriedWeight(st[1], 2, 2) + carriedWeight(st[2], 3, 1) +
          carriedWeight(st[3], 3, 1) + carriedWeight(st[4], 3, 1) + carriedWeight(st[5], 3, 1)) as Uint<32>;
}

circuit noStack(): Vector<14, Bytes<32>> { return default<Vector<14, Bytes<32>>>; }

/** The chart of the parent a link points to, or an empty chart for no link. */
circuit parentChart(id: Bytes<32>): Vector<14, Bytes<32>> {
  if (id == noLink()) {
    return noStack();
  }
  return stacks.lookup(links.lookup(id).parent);
}

/** Whether any ancestor in a chart takes a share (then royalty top-ups must be split, and name the offer). */
circuit chartSplits(st: Vector<14, Bytes<32>>): Boolean {
  return fold((acc: Boolean, id: Bytes<32>) => acc || shareAt(id) > 0, false, st);
}

/**
 * Pay `total` of `color`: each ancestor its share (the client supplies each amount,
 * checked here to be the share rounded down), the rest to `payTo`. In one call, holding
 * nothing. A place past its end date, with no share, or in another token, gets nothing.
 */
circuit paySplit(st: Vector<14, Bytes<32>>, color: Bytes<32>, total: Uint<64>, payTo: UserAddress): [] {
  const amounts = splitAmounts();
  receiveUnshielded(color, total as Uint<128>);
  for (const i of 0..14) {
    const id = st[i];
    const a = disclose(amounts[i]);
    if (id == noLink()) {
      assert(a == 0, "Nothing is owed to an empty place");
    } else {
      const l = links.lookup(id);
      if (l.share > 0 && l.color == color && blockTimeLt(l.until)) {
        // A parent's share in basis points; a grandparent's half of it; a great-grandparent's a quarter.
        // Rounded down, so the ancestors together never take more than the agreed cap.
        const d = (i < 2 ? 10000 : (i < 6 ? 20000 : 40000)) as Uint<16>;
        const want = total * l.share;
        assert(want >= d, "Too small a payment: every ancestor's share must come to at least one unit");
        assert(a * d <= want && want < a * d + d, "That is not the ancestor's share, rounded down");
        if (a > 0) {
          sendUnshielded(color, a as Uint<128>, right<ContractAddress, UserAddress>(l.payTo));
        }
      } else {
        assert(a == 0, "Nothing is owed to that place now");
      }
    }
  }
  const paid = disclose(fold((acc: Uint<128>, a: Uint<64>) => (acc + a) as Uint<128>, 0 as Uint<128>, amounts));
  assert(paid <= total as Uint<128>, "The ancestors' shares come to more than the payment");
  const rest = (total as Uint<128>) - paid;
  if (rest > 0) {
    sendUnshielded(color, rest, right<ContractAddress, UserAddress>(payTo));
  }
}

/** Each parent's fee for one licence, in its own token, while its link runs. */
circuit payFees(st: Vector<14, Bytes<32>>): [] {
  for (const i of 0..2) {
    const id = st[i];
    if (id != noLink()) {
      const l = links.lookup(id);
      if (l.fee > 0 && blockTimeLt(l.until)) {
        passThrough(l.color, l.fee as Uint<128>, l.payTo);
      }
    }
  }
}

circuit clearLicense(k: Bytes<32>, id: Bytes<32>, o: Offer): [] {
  const s = licenseSlotOf.lookup(k);
  licenses.insertIndexDefault(s);
  licenseSlotOf.remove(k);
  licenseAtSlot.remove(s);
  licenseOffer.remove(k);
  liveOf.lookup(id).decrement(1);
}

/** The licence a secret holds from an offer, as a tree leaf. */
circuit licenceLeaf(secret: Bytes<32>, offer: Bytes<32>, expires: Uint<64>): Bytes<32> {
  return licenseKey(licenseCommit(viewKey(secret, offer), spendKey(secret, offer), offer), offer, expires);
}

/** The same leaf, from the presentation key and the spending key (no licence secret). */
circuit licenceLeafOf(present: Bytes<32>, spend: Bytes<32>, offer: Bytes<32>, expires: Uint<64>): Bytes<32> {
  return licenseKey(licenseCommit(viewOf(present), spend, offer), offer, expires);
}

/**
 * The caller holds a licence from `offer`, ending at `expires`, in the licence tree.
 * Publishes only the root. The caller passes the end date it checked, read ONCE: a
 * witness read twice could answer differently each time.
 */
circuit provenLicence(secret: Bytes<32>, offer: Bytes<32>, expires: Uint<64>): MerkleTreeDigest {
  return provenLeaf(licenceLeaf(secret, offer, expires));
}

circuit provenLeaf(leaf: Bytes<32>): MerkleTreeDigest {
  const path = licensePath();
  assert(disclose(path.leaf == leaf), "No live licence for that secret");
  const root = disclose(merkleTreePathRoot<24, Bytes<32>>(path));
  assert(licenses.checkRoot(root), "No live licence for that secret, or the path is stale");
  return root;
}

/** The offer the caller opens privately, proved to be one of `offerLeaves`. Publishes only the root. */
circuit provenOffer(): OfferOpening {
  const op = offerOpening();
  const path = offerPath();
  assert(disclose(path.leaf == leafOf(op)),
         "That is not an offer on this contract");
  assert(offerLeaves.checkRoot(disclose(merkleTreePathRoot<32, Bytes<32>>(path))),
         "That is not an offer on this contract, or the path is stale");
  return op;
}

/**
 * Spend a credit note of the offer whose leaf is `leaf`: proved present, nullifier
 * published. Returns the nullifier, from which the change note's nonce is made.
 */
circuit spendNote(secret: Bytes<32>, offer: Bytes<32>, leaf: Bytes<32>, n: NoteOpening,
                  path: MerkleTreePath<32, Bytes<32>>): Bytes<32> {
  const note = noteCommit(topUpCode(spendKey(secret, offer), n.nonce), leaf, n.amount);
  assert(disclose(path.leaf == note), "That credit note is not yours");
  assert(notes.checkRoot(disclose(merkleTreePathRoot<32, Bytes<32>>(path))),
         "That credit note is not on chain, or the path is stale");
  const nf = disclose(nullifier(nullifierKey(secret), note));
  assert(!nullifiers.member(nf), "That credit note is already spent");
  nullifiers.insert(nf);
  lastNullifier = nf;
  return nf;
}

/** Create a credit note. Its commitment is all that is published. */
circuit addNote(note: Bytes<32>): [] {
  assert(!noteSeen.member(note), "That credit note already exists; use a new nonce");
  noteSeen.insert(note);
  notes.insert(note);
  rootsSinceSeal = true;
  lastNote = note;
}

// ─────────────────────────────────────────────────────────────── offers

export circuit postOffer(nonce: Bytes<32>, admin: Bytes<32>, terms: Bytes<32>, color: Bytes<32>, price: Uint<64>,
                         rate: Bytes<32>, payTo: UserAddress, count: Uint<32>, expires: Uint<64>,
                         revocable: Boolean): Bytes<32> {
  const record = disclose(recordCommit(recordSecret()));
  const id = disclose(offerId(record, nonce));
  assert(!everPosted.member(id), "An offer with that id was already posted; pick another nonce");
  const a = disclose(admin);
  assert(a != default<Bytes<32>>, "The admin commitment cannot be empty");
  const t = disclose(terms);
  assert(t != default<Bytes<32>>, "The terms fingerprint cannot be empty");
  const p = disclose(price);
  assert(p > 0, "The price must be more than zero");
  const n = disclose(count);
  assert(n > 0, "An offer must have at least one licence for sale");
  const e = disclose(expires);
  assertBefore(e);
  assert(e < MAX_TIME(), "That end date is too far ahead");
  const c = disclose(color);
  const r = disclose(rate);
  const w = disclose(payTo);
  // A record with no links finalises an empty chart here. One with links must finalise first.
  if (!stacks.member(record)) {
    assert((!linksConfirmed.member(record) || linksConfirmed.lookup(record) == 0) &&
           (!linksPending.member(record) || linksPending.lookup(record) == 0),
           "This record has descent links: finalise its ancestors (finaliseStack) before posting");
    stacks.insert(record, noStack());
  }
  const st = stacks.lookup(record);
  for (const i of 0..14) {
    const lid = st[i];
    if (lid != noLink()) {
      const l = links.lookup(lid);
      assert(shareAt(lid) == 0 || l.color == c,
             "An ancestor's share is owed in another token: post this offer in that token");
    }
  }
  const sp = chartSplits(st);
  assert(!sp || r != default<Bytes<32>>,
         "This record's ancestors take a share of royalties, so its offers must take royalties through the contract");
  // A rate commitment must open to a real rate: one nobody can open would sell credit no one could ever settle,
  // and would let a variety with ancestors dodge their share of royalties.
  if (r != default<Bytes<32>>) {
    const ro = rateOpening();
    assert(disclose(rateCommit(ro.rate, ro.salt) == r && ro.rate > 0), "That rate commitment does not open to a rate above zero");
  }
  offers.insert(id, Offer {
    record: record, admin: a, terms: t, color: c, price: p, rateCommit: r, payTo: w,
    count: n, expires: e, revocable: disclose(revocable), open: true, split: sp,
  });
  soldOf.insert(id, default<Counter>);
  liveOf.insert(id, default<Counter>);
  everPosted.insert(id);
  offerLeaves.insert(offerLeaf(id, w.bytes, c, r, e, sp));
  rootsSinceSeal = true;
  lastOffer = id;
  return id;
}

export circuit closeOffer(offer: Bytes<32>): [] {
  const id = disclose(offer);
  const o = anyOffer(id);
  assertAdmin(o);
  assert(o.open, "That offer is already closed");
  offers.insert(id, Offer { ...o, open: false });
}

export circuit changeOfferAdmin(offer: Bytes<32>, newAdmin: Bytes<32>): [] {
  const id = disclose(offer);
  const o = anyOffer(id);
  assertAdmin(o);
  const a = disclose(newAdmin);
  assert(a != default<Bytes<32>>, "The admin commitment cannot be empty");
  offers.insert(id, Offer { ...o, admin: a });
}

// ─────────────────────────────────────────────────────────────── sales

/** Buy one licence at `slot`. The price passes to the breeder's wallet in the same call. */
export circuit buyLicense(offer: Bytes<32>, slot: Uint<64>): [] {
  const id = disclose(offer);
  const o = anyOffer(id);
  assert(o.open, "That offer is closed");
  assertBefore(o.expires);
  assert(soldOf.lookup(id).lessThan(o.count as Uint<64>), "That offer is sold out");
  const k = disclose(licenceLeaf(licenseSecret(), id, o.expires));
  assert(!everSold.member(k), "That licence was already bought; use a new licence secret");
  const s = disclose(slot);
  assert(s < LICENSE_SLOTS(), "That slot is outside the licence tree");
  assert(!licenseAtSlot.member(s), "That slot is taken; pick another");
  const st = stacks.lookup(o.record);
  paySplit(st, o.color, o.price, o.payTo);
  payFees(st);
  soldOf.lookup(id).increment(1);
  liveOf.lookup(id).increment(1);
  everSold.insert(k);
  licenseOffer.insert(k, id);
  licenses.insertIndex(k, s);
  licenseSlotOf.insert(k, s);
  licenseAtSlot.insert(s, k);
  rootsSinceSeal = true;
  saleSeq.increment(1);
  lastSale = k;
}

export circuit revokeLicense(license: Bytes<32>): [] {
  const k = disclose(license);
  assert(licenseOffer.member(k), "No such live licence");
  const id = licenseOffer.lookup(k);
  const o = anyOffer(id);
  assert(o.revocable, "That offer's licences cannot be revoked");
  // Not after the end: the licensee's 30 days to settle the last period cannot be cut short.
  assertBefore(o.expires);
  assertAdmin(o);
  clearLicense(k, id, o);
  unsealedChanges = true;
  revocationSeq.increment(1);
  offerRevokedAt.insert(id, revocationSeq.read());
}

export circuit clearEnded(license: Bytes<32>): [] {
  const k = disclose(license);
  assert(licenseOffer.member(k), "No such live licence");
  const id = licenseOffer.lookup(k);
  const o = anyOffer(id);
  assert(blockTimeGte((o.expires + SETTLE_GRACE()) as Uint<64>),
         "That licence has not ended, or its 30 days to settle after the end are not over");
  clearLicense(k, id, o);
  rootsSinceSeal = true;
}

export circuit removeEnded(offer: Bytes<32>): [] {
  const id = disclose(offer);
  const o = anyOffer(id);
  assert(blockTimeGte(o.expires), "That offer has not ended");
  assert(liveOf.lookup(id).read() == 0, "Clear that offer's ended licences first");
  offers.remove(id);
}

/**
 * Retire old roots: of the licence tree when a revocation is waiting (so revoked licences
 * stop proving), and of every tree at most daily (only to bound their history). A seal
 * after mere sales or top-ups retires nothing, so nobody can void everyone's proofs in
 * flight at will. Anyone may call it once the block time is SEAL_INTERVAL past the last.
 */
export circuit sealRevocations(bound: Uint<64>): [] {
  const t = disclose(bound);
  assert(unsealedChanges || rootsSinceSeal, "Nothing has changed the trees since the last seal");
  assert(blockTimeGte((lastSealTime + SEAL_INTERVAL()) as Uint<64>), "Too soon since the last seal");
  assert(blockTimeLt(t), "That time is not ahead of the block time");
  assert(t >= SEAL_SLACK() && blockTimeGte((t - SEAL_SLACK()) as Uint<64>), "That time is too far ahead");
  if (unsealedChanges) {
    licenses.resetHistory();
  }
  if (blockTimeGte((lastSlowSealTime + SLOW_SEAL_INTERVAL()) as Uint<64>)) {
    licenses.resetHistory();
    offerLeaves.resetHistory();
    notes.resetHistory();
    receipts.resetHistory();
    lastSlowSealTime = t;
  }
  lastSealTime = t;
  sealedRevocations = revocationSeq.read();
  unsealedChanges = false;
  rootsSinceSeal = false;
  sealSeq.increment(1);
}

// ─────────────────────────────────────────────────────────────── credit

/**
 * Anyone tops up a licensee's royalty credit: `amount` passes to `payTo`, and a credit
 * note worth `amount` is created from the top-up code the licensee gave the payer. The
 * offer is proved privately: the public learns only that it is one of `payTo`'s offers in
 * `color` that takes royalties and is open until at least `validUntil` (a time the client
 * rounds, so it names no offer). Allowed until 30 days after the offer ends, so the last
 * season can be paid for.
 */
export circuit topUp(payTo: UserAddress, color: Bytes<32>, amount: Uint<64>, validUntil: Uint<64>): [] {
  const op = provenOffer();
  assert(disclose(!op.split), "That offer's ancestors take a share: top it up with topUpSplit");
  const w = disclose(payTo);
  const c = disclose(color);
  assert(disclose(op.payTo == w.bytes && op.color == c), "That offer pays another wallet or token");
  const ro = rateOpening();
  assert(disclose(op.rateCommit != default<Bytes<32>>), "That offer takes no royalties through this contract");
  assert(disclose(rateCommit(ro.rate, ro.salt) == op.rateCommit && ro.rate > 0),
         "That is not the offer's royalty rate, or it is zero: nothing could ever settle against this credit");
  const v = disclose(validUntil);
  assert(blockTimeLt(v), "The time the offer must be open until is already past");
  assert(disclose(op.expires + SETTLE_GRACE() >= v), "That offer's 30 days after its end are over by then");
  const a = disclose(amount);
  assert(a > 0, "A top-up must be more than zero");
  addNote(disclose(noteCommit(topUpCodeWitness(), leafOf(op), a)));
  passThrough(c, a as Uint<128>, w);
  topUpSeq.increment(1);
}

/**
 * A top-up for an offer whose ancestors take a share of royalties. It names the offer,
 * so it shows which variety is being paid for and how much; each ancestor's share and
 * the rest go out in the same call. The credit note is as private as any other.
 */
export circuit topUpSplit(offer: Bytes<32>, amount: Uint<64>): [] {
  const id = disclose(offer);
  const o = anyOffer(id);
  assert(o.split, "That offer's ancestors take no share: use topUp, which does not name the offer");
  assert(blockTimeLt((o.expires + SETTLE_GRACE()) as Uint<64>), "That offer's 30 days after its end are over");
  const ro = rateOpening();
  assert(disclose(rateCommit(ro.rate, ro.salt) == o.rateCommit && ro.rate > 0),
         "That is not the offer's royalty rate, or it is zero: nothing could ever settle against this credit");
  const a = disclose(amount);
  assert(a > 0, "A top-up must be more than zero");
  addNote(disclose(noteCommit(topUpCodeWitness(),
                              offerLeaf(id, o.payTo.bytes, o.color, o.rateCommit, o.expires, true), a)));
  paySplit(stacks.lookup(o.record), o.color, a, o.payTo);
  topUpSeq.increment(1);
}

/** The licensee joins two credit notes for the same offer into one. */
export circuit mergeNotes(): [] {
  const secret = licenseSecret();
  const op = offerOpening();
  const leaf = leafOf(op);
  const n1 = noteOpening();
  const n2 = secondNoteOpening();
  const nf = spendNote(secret, op.offer, leaf, n1, notePath());
  spendNote(secret, op.offer, leaf, n2, secondNotePath());
  const total = (n1.amount as Uint<128>) + (n2.amount as Uint<128>);
  assert(disclose(total < 18446744073709551616), "Those notes together are too large for one note");
  addNote(disclose(noteCommit(topUpCode(spendKey(secret, op.offer), changeNonceFor(secret, nf)), leaf,
                              total as Uint<64>)));
}

/**
 * The licensee settles one period: spends a credit note of the offer, proves
 * units x rate <= its value against the offer's rate commitment, keeps the change as a
 * new note, and records a receipt for (period, offer, units). Moves no money and names
 * no offer, licensee, period, rate or units; the breeder reads them with the viewing key.
 */
export circuit settle(): [] {
  const secret = licenseSecret();
  const op = provenOffer();
  const leaf = leafOf(op);
  provenLicence(secret, op.offer, licenceExpires());
  const ro = rateOpening();
  assert(disclose(rateCommit(ro.rate, ro.salt) == op.rateCommit && op.rateCommit != default<Bytes<32>> && ro.rate > 0),
         "That is not the offer's royalty rate");
  const n = noteOpening();
  const nf = spendNote(secret, op.offer, leaf, n, notePath());
  const units = settleUnits();
  assert(disclose(units > 0), "A settlement covers at least one unit");
  const owed = (units * ro.rate) as Uint<128>;
  assert(disclose((n.amount as Uint<128>) >= owed), "That credit note does not cover this period");
  const change = disclose(noteCommit(topUpCode(spendKey(secret, op.offer), changeNonceFor(secret, nf)), leaf,
                                     ((n.amount as Uint<128>) - owed) as Uint<64>));
  addNote(change);
  const view = viewKey(secret, op.offer);
  const r = disclose(receiptLeaf(receiptCommit(view, settlePeriod()), op.offer, units, change));
  receipts.insert(r);
  lastReceipt = r;
  const tag = disclose(settleTag(view, settleIndex()));
  assert(!settlementByTag.member(tag), "That settlement number is used: take the next one");
  settlementByTag.insert(tag, change);
  settlements.insert(change, Settlement {
    receipt: r, unitsMasked: disclose((units as Field) + unitsMask(view, change)), tag: tag,
  });
  settleSeq.increment(1);
}

// ─────────────────────────────────────────────────────────────── descent

/**
 * The child's holder proposes a link to a parent record, with the exact terms. Nothing
 * binds until the parent's holder confirms. Only before the child's ancestors are final.
 */
export circuit proposeLink(parent: Bytes<32>, color: Bytes<32>, fee: Uint<64>, share: Uint<16>,
                           generations: Uint<8>, until: Uint<64>, payTo: UserAddress, payee: Bytes<32>): Bytes<32> {
  const child = disclose(recordCommit(recordSecret()));
  const p = disclose(parent);
  assert(p != child && p != noLink(), "A link needs a parent record other than your own");
  assert(!stacks.member(child), "Your record's ancestors are final: no new links");
  const id = disclose(linkId(child, p));
  assert(!links.member(id), "That link was already proposed");
  const g = disclose(generations);
  assert(g >= 1 && g <= 3, "A link runs for 1 to 3 generations");
  const sh = disclose(share);
  assert(sh <= 5000, "A share is at most 5000 basis points");
  const u = disclose(until);
  assert(blockTimeLt(u), "The link's end date must be in the future");
  const pe = disclose(payee);
  assert(pe != noLink(), "The payee key commitment cannot be empty");
  const pending = linksPending.member(child) ? linksPending.lookup(child) : 0;
  assert(pending < MAX_PENDING_LINKS(), "Too many links waiting; withdraw one first");
  linksPending.insert(child, (pending + 1) as Uint<8>);
  links.insert(id, Link {
    child: child, parent: p, color: disclose(color), fee: disclose(fee), share: sh, generations: g,
    until: u, payTo: disclose(payTo), payee: pe, confirmed: false, changedAt: 0,
  });
  return id;
}

/** The child's holder withdraws a link the parent has not confirmed. */
export circuit withdrawLink(parent: Bytes<32>): [] {
  const child = disclose(recordCommit(recordSecret()));
  const id = disclose(linkId(child, disclose(parent)));
  assert(links.member(id) && !links.lookup(id).confirmed, "No unconfirmed link from your record to that one");
  links.remove(id);
  linksPending.insert(child, (linksPending.lookup(child) - 1) as Uint<8>);
}

/**
 * The parent's holder confirms a link on its terms. The parent's own ancestors must be
 * final first, so the child knows everything it takes on, and the parent has no later
 * step to withhold. Refused if the child's ancestors would take more than half.
 */
export circuit confirmLink(child: Bytes<32>, terms: Bytes<32>): [] {
  const parent = disclose(recordCommit(recordSecret()));
  const c = disclose(child);
  const id = disclose(linkId(c, parent));
  assert(links.member(id), "No link proposed from that record to yours");
  const l = links.lookup(id);
  assert(!l.confirmed, "That link is already confirmed");
  assert(disclose(terms) == linkTermsHash(l.color, l.fee, l.share, l.generations, l.until, l.payTo.bytes, l.payee),
         "That link's terms are not the ones you are confirming");
  assert(stacks.member(parent), "Finalise your own record's ancestors first (finaliseStack, or post an offer)");
  assert(!stacks.member(c), "That record's ancestors are already final");
  assert(blockTimeLt(l.until), "That link has already ended");
  const confirmed = linksConfirmed.member(c) ? linksConfirmed.lookup(c) : 0;
  assert(confirmed < MAX_LINKS(), "That record already has two confirmed parents");
  const before = linkWeight.member(c) ? linkWeight.lookup(c) : 0;
  const own = (l.share * 4) as Uint<32>;
  const weight = (before + own + inheritedWeight(stacks.lookup(parent))) as Uint<32>;
  assert(weight <= MAX_LINK_WEIGHT(), "With this link the record's ancestors would take more than half");
  // Every share the child's chart could hold must be owed in one token, or it could never post an offer.
  const st = stacks.lookup(parent);
  const t0 = shareTokenOf.member(c) ? ShareToken { known: true, color: shareTokenOf.lookup(c) } : unknownToken();
  const t1 = withToken(t0, l.share > 0, l.color);
  const t2 = withCarried(withCarried(t1, st[0], 2), st[1], 2);
  const t3 = withCarried(withCarried(withCarried(withCarried(t2, st[2], 3), st[3], 3), st[4], 3), st[5], 3);
  if (t3.known) {
    shareTokenOf.insert(c, t3.color);
  }
  links.insert(id, Link { ...l, confirmed: true });
  linksConfirmed.insert(c, (confirmed + 1) as Uint<8>);
  linksPending.insert(c, (linksPending.lookup(c) - 1) as Uint<8>);
  linkWeight.insert(c, weight);
  linkSeq.increment(1);
  lastLink = id;
}

/**
 * The child's holder makes its ancestors final, naming EVERY confirmed link of its record
 * (at most two): a parent's agreed terms cannot be left out. The chart is built from data
 * the contract holds: the links, then each parent's chart one generation further, keeping
 * only links that still run there. Once, forever.
 */
export circuit finaliseStack(first: Bytes<32>, second: Bytes<32>): [] {
  const child = disclose(recordCommit(recordSecret()));
  assert(!stacks.member(child), "Your record's ancestors are already final");
  assert(!linksPending.member(child) || linksPending.lookup(child) == 0,
         "A link of your record is still waiting for its parent: withdraw it or wait for the answer");
  const l1 = disclose(first);
  const l2 = disclose(second);
  assert(l1 != noLink() || l2 == noLink(), "Name the first link before the second");
  assert(l2 == noLink() || l1 != l2, "The two links must differ");
  const confirmed = linksConfirmed.member(child) ? linksConfirmed.lookup(child) : 0;
  const named = ((l1 != noLink() ? 1 : 0) + (l2 != noLink() ? 1 : 0)) as Uint<8>;
  assert(named == confirmed, "Name every confirmed link of your record: a parent's agreed terms cannot be left out");
  if (l1 != noLink()) {
    assert(links.member(l1) && links.lookup(l1).confirmed && links.lookup(l1).child == child,
           "The first link is not a confirmed link of your record");
  }
  if (l2 != noLink()) {
    assert(links.member(l2) && links.lookup(l2).confirmed && links.lookup(l2).child == child,
           "The second link is not a confirmed link of your record");
  }
  const a = parentChart(l1);
  const b = parentChart(l2);
  stacks.insert(child, [
    l1, l2,
    carried(a[0], 2), carried(a[1], 2), carried(b[0], 2), carried(b[1], 2),
    carried(a[2], 3), carried(a[3], 3), carried(a[4], 3), carried(a[5], 3),
    carried(b[2], 3), carried(b[3], 3), carried(b[4], 3), carried(b[5], 3),
  ]);
}

/**
 * A record that replaced an earlier one (a key rotation or recovery in the main
 * contract) takes over its chart unchanged, with no parent asked again. The client
 * accepts this only when the main contract shows both records are one identity.
 */
export circuit adoptStack(earlier: Bytes<32>): [] {
  const record = disclose(recordCommit(recordSecret()));
  const e = disclose(earlier);
  assert(!stacks.member(record), "Your record's ancestors are already final");
  assert((!linksConfirmed.member(record) || linksConfirmed.lookup(record) == 0) &&
         (!linksPending.member(record) || linksPending.lookup(record) == 0),
         "Your record has links of its own: finalise them instead");
  assert(stacks.member(e), "That record's ancestors are not final");
  stacks.insert(record, stacks.lookup(e));
}

/** A time the caller names, checked to be within the last five minutes of the block time. */
circuit recentTime(at: Uint<64>): Uint<64> {
  const t = disclose(at);
  assert(blockTimeGte(t) && blockTimeLt((t + SEAL_SLACK()) as Uint<64>), "That time is not the current time");
  return t;
}

circuit payeeLink(id: Bytes<32>): Link {
  assert(links.member(id), "No such link");
  const l = links.lookup(id);
  assert(disclose(payeeCommit(adminSecret()) == l.payee), "Only the link's payee key can change it");
  assert(blockTimeGte((l.changedAt + PAYEE_CHANGE_INTERVAL()) as Uint<64>), "The payee key changed this link less than 30 days ago");
  return l;
}

/** The link's payee key moves where its fee and share are paid. Only the payee, never the child; once in 30 days. */
export circuit movePayee(link: Bytes<32>, payTo: UserAddress, now: Uint<64>): [] {
  const id = disclose(link);
  const l = payeeLink(id);
  links.insert(id, Link { ...l, payTo: disclose(payTo), changedAt: recentTime(now) });
}

/**
 * The link's payee key lowers its terms (a protection that ended, a dispute settled, a
 * ruling): a smaller share or fee, or an earlier end. Never raises them. Once in 30 days.
 */
export circuit relaxLink(link: Bytes<32>, share: Uint<16>, fee: Uint<64>, until: Uint<64>, now: Uint<64>): [] {
  const id = disclose(link);
  const l = payeeLink(id);
  const sh = disclose(share);
  const f = disclose(fee);
  const u = disclose(until);
  assert(sh <= l.share && f <= l.fee && u <= l.until, "A link's terms can only be lowered");
  links.insert(id, Link { ...l, share: sh, fee: f, until: u, changedAt: recentTime(now) });
}

// ─────────────────────────────────────────────────────────────── presentations

/**
 * A licensee proves to ONE verifier a licence from ONE offer and, unless `period` is zero,
 * a settlement for that period covering at least `minUnits`. If `live`, the licence must
 * still be live at `validAt`; without it (only with a period), the proof is that the
 * period was settled under a licence from the offer, even if that licence has since ended
 * (its last season). Needs only the presentation key and the public spending key, never
 * the licence secret. Publishes presentationTag(...) and holderTag(present, offer, scope),
 * and the roots proved against.
 */
export circuit proveLicense(period: Bytes<32>, minUnits: Uint<64>, validAt: Uint<64>, scope: Bytes<32>,
                            live: Boolean): [] {
  const offer = presentationOffer();
  const challenge = presentationChallenge();
  assert(disclose(challenge != default<Bytes<32>>), "A presentation needs the verifier's challenge");
  assert(disclose(scope != default<Bytes<32>>), "A presentation needs the verifier's scope");
  const v = disclose(validAt);
  assert(blockTimeLt(v), "The time to be valid at must be in the future");
  const lv = disclose(live);
  const hasPeriod = disclose(period != default<Bytes<32>>);
  assert(lv || hasPeriod, "A presentation with no period must ask for a live licence");
  const expires = licenceExpires();
  if (lv) {
    assert(disclose(expires > v), "That licence ends at or before the time asked");
  }
  const present = presentationKey();
  const root = provenLeaf(licenceLeafOf(present, licenceSpendKey(), offer, expires));
  if (hasPeriod) {
    const units = receiptUnits();
    assert(disclose(units >= minUnits), "No settlement for that period covers that many units");
    const rpath = receiptPath();
    assert(disclose(rpath.leaf == receiptLeaf(receiptCommit(viewOf(present), period), offer, units, receiptChange())),
           "No settlement for that period covers that many units");
    const rroot = disclose(merkleTreePathRoot<32, Bytes<32>>(rpath));
    assert(receipts.checkRoot(rroot), "No settlement for that period, or the path is stale");
    lastPresentationReceiptRoot = rroot;
  } else {
    lastPresentationReceiptRoot = default<MerkleTreeDigest>;
  }
  presentationSeq.increment(1);
  lastPresentationRoot = root;
  lastPresentationHolder = disclose(holderTag(present, offer, scope));
  lastPresentation = disclose(presentationTag(offer, period, minUnits, v, scope, challenge, lv));
}
