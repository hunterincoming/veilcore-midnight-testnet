// Veilcore: on-chain provenance + licensing for plant genetics.
// SPDX-License-Identifier: Apache-2.0
//
// Only commitments (domain-separated hashes) are ever stored on-chain. Genetic
// preimages, license terms, and counterparties stay off-chain as private witnesses.
//
// STATE MODEL. Anchoring writes no growable state — the commitment lives in the
// transaction, and the chain already retains transaction history. Licensing holds
// only LIVE agreements; terminal licences are removed, so the maps track open
// business rather than accumulating every licence ever issued.
//
// That is not the same as being bounded against an adversary, and the earlier
// wording claimed more than it could. `issueLicense` requires owning a record,
// but a record is owned by committing a secret and anyone can choose one. A party
// with no material can therefore issue licences to themselves and grow the maps,
// paying a fee per entry. The bound is economic, not structural. Stated plainly
// here because a reader who takes "bounded by design" at face value will not look.
//
// The active-licence tree adds one root cell and no growable state at all: it holds
// live licences only, and a slot freed by revocation or assignment is reusable. Its
// capacity is 65,536 CONCURRENT active licences, which is a hard ceiling rather than
// an economic one — the one place in this contract where a limit is structural.
//
// Two maps now grow permanently and are not bounded by open business at all:
// `recoveryOf` gains an entry per anchored record, `rotatedTo` an entry per
// rotation, and neither is ever cleared. That is the price of the two guarantees
// they carry — that a lost secret is not final, and that a retired secret stops
// working — and neither can be kept without remembering something. An entry is
// 64 bytes and a holder pays a transaction fee to create one.

pragma language_version 0.23;

import CompactStandardLibrary;

// Lifecycle status for a license commitment.
export enum LicenseState { NONE, PENDING, ACTIVE, REVOKED }

// Fixed single-slot fields. No growable container.
export ledger anchorSeq: Counter;
export ledger lastAnchor: Bytes<32>;
export ledger proofSeq: Counter;
export ledger batchSeq: Counter;
export ledger lastBatchRoot: Bytes<32>;
export ledger transferSeq: Counter;

// A value a verifier needs has to be written to the ledger. Returning it from an
// exported circuit does not put it on chain: the return travels in the call's
// communication commitment, which is blinded with randomness, so it reaches the
// caller's own DApp and nobody else. An earlier revision of this contract returned
// these values and described that as publishing them. It was not.
//
// Separate cells rather than reusing lastAnchor: `anchor` proves the preimage of
// what it writes there, and these circuits do not, so a reader treating that cell's
// history as anchors would otherwise collect possession dates nobody proved.
export ledger lastOwnershipProof: Bytes<32>;
export ledger lastPairedRecord: Bytes<32>;
export ledger lastRotatedFrom: Bytes<32>;
export ledger lastRotatedTo: Bytes<32>;

/**
 * Where a retired record went. Set once per record and never cleared.
 *
 * Every circuit gated on holding a record consults this. Without it a rotation
 * changed nothing that mattered: the old secret still issued licences, still
 * revoked them, and still paired DNA, while the new record could not revoke
 * anything issued under the old one. A holder rotating away from a compromised
 * secret was left with two working identities instead of one.
 */
export ledger rotatedTo: Map<Bytes<32>, Bytes<32>>;

/**
 * The recovery commitment for a record, set at anchor time.
 *
 * Absent for records anchored before this existed; those keep the old behaviour,
 * where a lost secret is final.
 */
export ledger recoveryOf: Map<Bytes<32>, Bytes<32>>;
/** Transfers proposed but not yet approved. Cleared on approval or withdrawal. */
export ledger pendingTransferOf: Map<Bytes<32>, Bytes<32>>;
// Live licences only. Removed on revocation and on assignment, so bounded by open
// agreements. The KEY IS THE HOLDER: only a party who knows the secret behind a
// commitment can act on that licence, so no separate holder field is needed and none
// can drift out of step with who actually controls it.
export ledger licenseStatusOf: Map<Bytes<32>, LicenseState>;
export ledger licenseRecordOf: Map<Bytes<32>, Bytes<32>>;

// The caller's private genetic secret, supplied by the wallet's private state.
witness localGeneticSecret(): Bytes<32>;

/** The secret a rotation is moving TO. Proved, not taken on trust. */
witness incomingGeneticSecret(): Bytes<32>;

/**
 * A second secret, chosen at anchor time and kept apart from the first.
 *
 * Its commitment is published when the record is anchored, and it is the only way
 * to move a record whose primary secret is gone. Without it "rotate before you lose
 * it" is the whole remedy, which is no remedy: nobody rotates in anticipation of an
 * accident they have not had.
 */
witness recoverySecret(): Bytes<32>;

// Domain-separated commitment to a genetic secret. RECORDS ONLY.
//
// This tag used to serve licences as well, which made a licence commitment and a
// record commitment the same function of a secret. A licensee could therefore load
// their licence secret as a genetic secret, anchor the licence as a record of their
// own, and issue sublicences against it without the breeder being party to any of
// it. Two kinds of thing must not share a domain.
export circuit commit(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilcore:commit"), secret]);
}

/**
 * Commitment to a licence secret, BOUND TO THE RECORD IT IS ISSUED AGAINST.
 *
 * The record is inside the hash, not alongside it. A licence commitment therefore
 * only exists in the context of one issuing record, which closes two attacks that
 * an unbound commitment left open:
 *
 * A sniper who reads a pending issueLicense out of the transcript and issues that
 * commitment first under their own record now produces a DIFFERENT value, so their
 * entry does not collide with the breeder's and the licensee's countersignature
 * does not land on it.
 *
 * And an outgoing licensee who re-issues an assigned licence's old commitment under
 * a record they control also produces a different value, so the resurrected entry
 * is not the licence anyone agreed to and proveLicense against it fails.
 */
export circuit licenseCommit(secret: Bytes<32>, recordCommitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:license"), secret, recordCommitment]);
}

// ─────────────────────────────────────────────────── the active-licence tree
//
// GENERATED, like lineage.compact's fold, and for the same reason: Compact has no
// loops, so a depth-16 tree is 16 unrolled steps and 32 for a replacement. They were
// produced mechanically rather than typed.
//
// WHY THERE IS A TREE AT ALL. proveLicense used to look the licence commitment up
// in licenseStatusOf. A map lookup puts its key in the public transcript, and
// licenseRecordOf maps that key to the issuing record — so every presentation of a
// licence named the breeder, and two presentations of the same licence were
// trivially linkable to each other. The comment above it claimed the opposite.
//
// A presentation against a ROOT names nothing. The leaf is the licence commitment,
// the path is a private witness, and the only public statement is that some leaf in
// the current tree was opened by someone who knows the secret behind it.
//
// POSITIONS ARE NOT DERIVED from the commitment, unlike the obligation tree's slots.
// Nothing needs them to be: an insert proves the slot it targets is empty, and a
// removal proves the leaf it names is where it says. Leaving position free means no
// birthday bound and no grinding target — 65536 concurrent ACTIVE licences, all of
// them usable, rather than a collision becoming likely in the hundreds.
//
// Capacity is concurrent, not cumulative: revocation and assignment free slots.

export ledger activeLicenseRoot: Bytes<32>;

/**
 * The licensee's licence secret, and the record it was issued against.
 *
 * Witnesses rather than arguments, because an argument to proveLicense is a public
 * value and naming either one is the whole defect.
 */
witness licenseSecret(): Bytes<32>;
witness licenseRecord(): Bytes<32>;
witness licenseSiblings(): Vector<16, Bytes<32>>;
witness licenseDirections(): Vector<16, Boolean>;

// Its own domain tag. Record commitments, licence commitments and tree nodes are
// three kinds of thing, and two of them sharing a tag is what let a licence secret
// be loaded as a genetic secret and anchored as a record of its own.
export circuit licenseNode(node: Bytes<32>, sibling: Bytes<32>, siblingIsLeft: Boolean): Bytes<32> {
  const left = siblingIsLeft ? sibling : node;
  const right = siblingIsLeft ? node : sibling;
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:licnode"), left, right]);
}

export circuit licenseMerkleRoot(
  leaf: Bytes<32>,
  siblings: Vector<16, Bytes<32>>,
  dirs: Vector<16, Boolean>,
): Bytes<32> {
  const n0 = licenseNode(leaf, siblings[0], dirs[0]);
  const n1 = licenseNode(n0, siblings[1], dirs[1]);
  const n2 = licenseNode(n1, siblings[2], dirs[2]);
  const n3 = licenseNode(n2, siblings[3], dirs[3]);
  const n4 = licenseNode(n3, siblings[4], dirs[4]);
  const n5 = licenseNode(n4, siblings[5], dirs[5]);
  const n6 = licenseNode(n5, siblings[6], dirs[6]);
  const n7 = licenseNode(n6, siblings[7], dirs[7]);
  const n8 = licenseNode(n7, siblings[8], dirs[8]);
  const n9 = licenseNode(n8, siblings[9], dirs[9]);
  const n10 = licenseNode(n9, siblings[10], dirs[10]);
  const n11 = licenseNode(n10, siblings[11], dirs[11]);
  const n12 = licenseNode(n11, siblings[12], dirs[12]);
  const n13 = licenseNode(n12, siblings[13], dirs[13]);
  const n14 = licenseNode(n13, siblings[14], dirs[14]);
  const n15 = licenseNode(n14, siblings[15], dirs[15]);
  return n15;
}

// Verify the current leaf and compute the replacement in one traversal: the
// siblings are the same for both, so folding twice would double the constraint
// count for nothing. Returns [old root, new root]; the caller asserts the old one.
export circuit licenseReplaceLeaf(
  oldLeaf: Bytes<32>,
  newLeaf: Bytes<32>,
  siblings: Vector<16, Bytes<32>>,
  dirs: Vector<16, Boolean>,
): Vector<2, Bytes<32>> {
  const o0 = licenseNode(oldLeaf, siblings[0], dirs[0]);
  const w0 = licenseNode(newLeaf, siblings[0], dirs[0]);
  const o1 = licenseNode(o0, siblings[1], dirs[1]);
  const w1 = licenseNode(w0, siblings[1], dirs[1]);
  const o2 = licenseNode(o1, siblings[2], dirs[2]);
  const w2 = licenseNode(w1, siblings[2], dirs[2]);
  const o3 = licenseNode(o2, siblings[3], dirs[3]);
  const w3 = licenseNode(w2, siblings[3], dirs[3]);
  const o4 = licenseNode(o3, siblings[4], dirs[4]);
  const w4 = licenseNode(w3, siblings[4], dirs[4]);
  const o5 = licenseNode(o4, siblings[5], dirs[5]);
  const w5 = licenseNode(w4, siblings[5], dirs[5]);
  const o6 = licenseNode(o5, siblings[6], dirs[6]);
  const w6 = licenseNode(w5, siblings[6], dirs[6]);
  const o7 = licenseNode(o6, siblings[7], dirs[7]);
  const w7 = licenseNode(w6, siblings[7], dirs[7]);
  const o8 = licenseNode(o7, siblings[8], dirs[8]);
  const w8 = licenseNode(w7, siblings[8], dirs[8]);
  const o9 = licenseNode(o8, siblings[9], dirs[9]);
  const w9 = licenseNode(w8, siblings[9], dirs[9]);
  const o10 = licenseNode(o9, siblings[10], dirs[10]);
  const w10 = licenseNode(w9, siblings[10], dirs[10]);
  const o11 = licenseNode(o10, siblings[11], dirs[11]);
  const w11 = licenseNode(w10, siblings[11], dirs[11]);
  const o12 = licenseNode(o11, siblings[12], dirs[12]);
  const w12 = licenseNode(w11, siblings[12], dirs[12]);
  const o13 = licenseNode(o12, siblings[13], dirs[13]);
  const w13 = licenseNode(w12, siblings[13], dirs[13]);
  const o14 = licenseNode(o13, siblings[14], dirs[14]);
  const w14 = licenseNode(w13, siblings[14], dirs[14]);
  const o15 = licenseNode(o14, siblings[15], dirs[15]);
  const w15 = licenseNode(w14, siblings[15], dirs[15]);
  return [o15, w15];
}

/**
 * Start the licence tree at the root of an empty tree.
 *
 * veilcore had no constructor. Adding a tree without one would have repeated
 * finding 1 exactly: the root would start at the default Bytes<32>, which is an
 * unset cell rather than a tree, no fold could ever reproduce it, and every
 * countersignature and every licence proof would fail in every deployment.
 */
constructor() {
  const nullLeaf = default<Bytes<32>>;
  const l0 = licenseNode(nullLeaf, nullLeaf, false);
  const l1 = licenseNode(l0, l0, false);
  const l2 = licenseNode(l1, l1, false);
  const l3 = licenseNode(l2, l2, false);
  const l4 = licenseNode(l3, l3, false);
  const l5 = licenseNode(l4, l4, false);
  const l6 = licenseNode(l5, l5, false);
  const l7 = licenseNode(l6, l6, false);
  const l8 = licenseNode(l7, l7, false);
  const l9 = licenseNode(l8, l8, false);
  const l10 = licenseNode(l9, l9, false);
  const l11 = licenseNode(l10, l10, false);
  const l12 = licenseNode(l11, l11, false);
  const l13 = licenseNode(l12, l12, false);
  const l14 = licenseNode(l13, l13, false);
  const l15 = licenseNode(l14, l14, false);
  activeLicenseRoot = l15;
}

/**
 * Refuse a record that has been rotated away from.
 *
 * Called by every circuit that acts on the strength of holding a record. A retired
 * identity keeps its secret — a secret cannot be un-known — so the only thing that
 * can stop it acting is the contract declining to listen.
 */
export circuit assertLive(recordCommitment: Bytes<32>): [] {
  assert(!rotatedTo.member(disclose(recordCommitment)),
         "This record was rotated to a new secret; act under the new one");
}

// Anchor a record. The caller proves they hold the preimage; the commitment is
// disclosed into the transaction. No per-record state is written.
export circuit anchor(commitment: Bytes<32>, recoveryCommitment: Bytes<32>): [] {
  assert(commitment == commit(localGeneticSecret()), "Commitment does not match your genetic secret");
  // Taken at anchor time because it cannot be added later by anyone who has already
  // lost the secret that would authorise adding it.
  assert(recoveryCommitment != commitment, "The recovery commitment must differ from the record");
  const c = disclose(commitment);
  assert(!recoveryOf.member(c), "This record is already anchored");
  anchorSeq.increment(1);
  lastAnchor = c;
  recoveryOf.insert(c, disclose(recoveryCommitment));
}

// Prove prior possession. Discloses the commitment in a dated transaction that
// only the holder of the preimage could produce. A verifier checks this proof
// against the earlier anchor transaction off-chain; the interval between them is
// the evidence. No per-record state is written.
/**
 * Anchor a batch root.
 *
 * A batch root aggregates many record commitments, so one transaction timestamps
 * thousands of records and no holder needs a wallet of their own.
 *
 * Unlike `anchor`, there is no preimage to prove: a root is a public value derived from
 * commitments the registry already holds, and nobody knows a secret behind it. The
 * privacy that matters was already applied when each record was committed — the root
 * reveals nothing about what it contains.
 *
 * State stays bounded: the root is disclosed into the transaction and only a counter
 * and one slot are written, the same pattern as `anchor`.
 *
 * ⚠️ THIS CIRCUIT IS UNAUTHENTICATED, deliberately. Anyone may anchor any root, and
 * `lastBatchRoot` therefore holds whichever root was written most recently by anyone
 * at all. It is a convenience slot, not a statement about who anchored. An inclusion
 * proof is checked by folding the path and comparing against the root recorded in the
 * transaction the holder cites — never against this slot, which a later caller can
 * overwrite. Reading `lastBatchRoot` as authoritative would turn a scratch value into
 * evidence, which is the failure this contract exists to avoid.
 */
export circuit anchorBatch(root: Bytes<32>): [] {
  const r = disclose(root);
  batchSeq.increment(1);
  lastBatchRoot = r;
}

export circuit proveOwnership(): Bytes<32> {
  // WRITTEN to the ledger, not merely returned. The return value goes into the
  // call's communication commitment, which is blinded, so it is visible to the
  // caller and to nobody reading the chain — an earlier revision returned it and
  // called that publishing. A prior-possession proof that a third party cannot
  // tie to a record establishes nothing, which is the whole claim this circuit
  // exists to support.
  const c = disclose(commit(localGeneticSecret()));
  proofSeq.increment(1);
  lastOwnershipProof = c;
  return c;
}


// Bind a DNA report fingerprint to a record you own. The binding is the
// transaction; no state is written.
export circuit pairDna(recordCommitment: Bytes<32>, dnaCommitment: Bytes<32>): Bytes<32> {
  assert(recordCommitment == commit(localGeneticSecret()), "Only the record owner can pair DNA");
  assertLive(recordCommitment);
  const rc = disclose(recordCommitment);
  const dc = disclose(dnaCommitment);
  anchorSeq.increment(1);
  // The pairing is the point, so both halves have to be public. Writing only the
  // DNA side published a fingerprint attached to nothing: an observer learned
  // that somebody paired a report, not to which record. The record commitment is
  // returned so the transaction carries both and the binding is checkable.
  // Both halves written. lastAnchor held the DNA side only, so the chain showed a
  // fingerprint attached to nothing and the pairing — which is the point of the
  // circuit — was not public. The record side goes in its own cell because
  // `anchor` proves a preimage for what it writes to lastAnchor and this does not.
  lastAnchor = dc;
  lastPairedRecord = rc;
  return rc;
}

/**
 * Issue a licence against a record the caller owns. Starts PENDING (issuer signed).
 *
 * THE LICENSEE GENERATES THE LICENCE SECRET and gives the issuer only its commitment.
 * The contract cannot check this, and it is what makes countersignature meaningful: an
 * issuer who generates the secret themselves can also countersign, which is a licence
 * issued to nobody. Stated here because it is a requirement on the parties rather than
 * something a circuit can enforce.
 */
export circuit issueLicense(recordCommitment: Bytes<32>, licenseCommitment: Bytes<32>): [] {
  assert(recordCommitment == commit(localGeneticSecret()), "Only the record owner can issue a license");
  assertLive(recordCommitment);
  const rc = disclose(recordCommitment);
  const lc = disclose(licenseCommitment);
  assert(!licenseStatusOf.member(lc), "License already exists");
  licenseStatusOf.insert(lc, LicenseState.PENDING);
  licenseRecordOf.insert(lc, rc);
}

// The licensee's counter-signature activates a pending license.
export circuit countersignLicense(secret: Bytes<32>, recordCommitment: Bytes<32>): [] {
  // The commitment is DERIVED from the licensee's secret AND the record it was
  // issued against. Deriving it from the secret alone meant the same secret
  // produced the same commitment whoever issued it, so a licence a sniper had
  // registered first under their own record was the same key the licensee
  // countersigned — and the licence went active under the sniper.
  //
  // Naming the record here is what makes the countersignature an agreement with a
  // specific breeder rather than with whoever got the key into the map first.
  const rc = disclose(recordCommitment);
  const lc = disclose(licenseCommit(secret, rc));
  assert(licenseStatusOf.member(lc), "No such license against that record");
  assert(licenseStatusOf.lookup(lc) == LicenseState.PENDING, "License is not pending");
  assert(licenseRecordOf.lookup(lc) == rc, "This license was not issued against that record");
  licenseStatusOf.insert(lc, LicenseState.ACTIVE);

  // ACTIVATION IS WHAT PUTS A LICENCE IN THE TREE. A pending licence is one the
  // issuer has signed and nobody has accepted, so there is nothing to present yet;
  // countersigning is the moment it becomes provable, and the tree holds exactly
  // the set proveLicense is allowed to open.
  const nullLeaf = default<Bytes<32>>;
  const roots = licenseReplaceLeaf(nullLeaf, lc, licenseSiblings(), licenseDirections());
  assert(disclose(roots[0]) == activeLicenseRoot,
         "That licence tree slot is not empty, or the path is invalid");
  activeLicenseRoot = disclose(roots[1]);
}


// Only the issuing record owner can revoke. Revocation is disclosed into the
// transaction and the live entry is removed, keeping state bounded.
/**
 * Propose transferring a licence to a new holder.
 *
 * A licence is not a bearer instrument. The USDA's own plant variety licence template
 * grants a "nontransferable" licence, and permits sublicensing only "subject to the
 * prior submission to and approval by USDA of the proposed sublicense". A freely
 * transferable token would be a cleaner object and the wrong one — it would let a
 * licensee hand rights to a party the breeder never agreed to.
 *
 * So transfer is a two-party act, the same shape as countersigning: the holder proposes
 * and the issuer approves. Until both happen, nothing moves.
 */
export circuit proposeTransfer(secret: Bytes<32>, recordCommitment: Bytes<32>, newLicenseCommitment: Bytes<32>): [] {
  // Derived, not accepted. Only the holder of the licence secret may propose
  // assigning it. Taking the commitment as an argument let anyone write into
  // the pending slot, and because insert overwrites, a stranger could replace a
  // proposal the issuer had already agreed to out of band.
  //
  // The incoming party generates their OWN secret and hands over only its
  // commitment. That is what makes the assignment real: after approval the
  // licence lives under a key the outgoing party has never seen.
  const rc = disclose(recordCommitment);
  const lc = disclose(licenseCommit(secret, rc));
  assert(licenseStatusOf.member(lc), "No such license against that record");
  assert(licenseStatusOf.lookup(lc) == LicenseState.ACTIVE, "Only an active license can be transferred");
  assert(licenseRecordOf.lookup(lc) == rc, "This license was not issued against that record");
  // One live proposal at a time. Replacing a standing proposal is a withdrawal
  // followed by a new one, both of which the holder must authorise.
  assert(!pendingTransferOf.member(lc), "A transfer is already proposed for this license");
  const nlc = disclose(newLicenseCommitment);
  assert(!licenseStatusOf.member(nlc), "That licence commitment is already in use");
  transferSeq.increment(1);
  pendingTransferOf.insert(lc, nlc);
}

/**
 * The issuer approves a proposed transfer.
 *
 * Only the party who issued the licence can approve. This is the approval gate that
 * makes the licence permissioned rather than a bearer token, and it is what stops a
 * licensee routing rights to someone the breeder would have refused.
 */
export circuit approveTransfer(licenseCommitment: Bytes<32>, recordCommitment: Bytes<32>, expectedNewLicense: Bytes<32>): [] {
  const lc = disclose(licenseCommitment);
  assert(pendingTransferOf.member(lc), "No transfer proposed for this license");
  assert(recordCommitment == commit(localGeneticSecret()), "Only the issuing record holder can approve");
  assertLive(recordCommitment);
  assert(licenseRecordOf.lookup(lc) == disclose(recordCommitment), "This license was not issued against your record");

  // The issuer approves a PARTY, not a slot. Without this the approval lands on
  // whatever is pending at execution time, so a proposal seen and agreed out of
  // band can be replaced between agreement and approval, and the licence moves
  // to someone the issuer never saw. Naming the recipient is what makes the
  // approval gate above mean anything.
  const nlc = pendingTransferOf.lookup(lc);
  assert(nlc == disclose(expectedNewLicense), "The pending recipient is not the one you approved");

  // The old licence ENDS and a new one BEGINS. Reassigning a holder field would
  // move nothing: the outgoing party still knows the old secret, so they could
  // still prove the licence and still propose further assignments, and the
  // incoming party could do nothing at all. Removing the old key is what ends
  // the outgoing party's rights, which is what "non-delegable" requires.
  //
  // The new licence starts ACTIVE rather than PENDING: it is not a fresh
  // agreement awaiting countersignature but the same agreement continuing with
  // a party the issuer has just consented to, and the incoming party
  // demonstrated consent by generating the secret.
  licenseStatusOf.remove(lc);
  licenseRecordOf.remove(lc);
  pendingTransferOf.remove(lc);
  licenseStatusOf.insert(nlc, LicenseState.ACTIVE);
  licenseRecordOf.insert(nlc, disclose(recordCommitment));
  transferSeq.increment(1);

  // The outgoing leaf is REPLACED by the incoming one, in place. One fold rather
  // than a removal and an insertion: the agreement continues, so the slot it
  // occupies continues with it, and the outgoing party's leaf stops being openable
  // at the same instant the incoming party's starts.
  const roots = licenseReplaceLeaf(lc, nlc, licenseSiblings(), licenseDirections());
  assert(disclose(roots[0]) == activeLicenseRoot,
         "That licence is not at the position given, or the path is invalid");
  activeLicenseRoot = disclose(roots[1]);
}

/** Withdraw a proposed transfer. Either the proposal expires or it is retracted. */
export circuit withdrawTransfer(secret: Bytes<32>, recordCommitment: Bytes<32>): [] {
  // Derived, not accepted. Withdrawal is the holder cancelling their own
  // proposal, so the caller proves they hold the licence secret. Taking the
  // commitment as an argument let any observer cancel any pending transfer and
  // block a licence from moving indefinitely.
  const lc = disclose(licenseCommit(secret, disclose(recordCommitment)));
  assert(pendingTransferOf.member(lc), "No transfer proposed for this license");
  pendingTransferOf.remove(lc);
  transferSeq.increment(1);
}

export circuit revokeLicense(licenseCommitment: Bytes<32>): [] {
  const lc = disclose(licenseCommitment);
  assert(licenseStatusOf.member(lc), "No such license");
  // The successor may revoke. A rotation that left the new record unable to revoke
  // licences issued under the old one meant a holder escaping a compromised secret
  // gave up control of every agreement they had already made.
  // Disclosed once, up front. A commitment is public by construction — it is a map
  // key elsewhere in this contract — but the compiler tracks it as witness-derived
  // until said otherwise, and a comparison that branches on it would leak a bit
  // about the secret if it were not declared.
  const me = disclose(commit(localGeneticSecret()));
  const issuer = licenseRecordOf.lookup(lc);
  assert(issuer == me || (rotatedTo.member(issuer) && rotatedTo.lookup(issuer) == me),
         "Only the issuer, or the record they rotated to, can revoke");
  assertLive(me);
  // Read before the removal below, and before the tree is touched. Only an ACTIVE
  // licence has a leaf: a PENDING one was issued and never accepted, so there is
  // nothing in the tree to take out and requiring a path for it would make a
  // pending licence unrevokable. Both states are public, so branching on this
  // leaks nothing that the maps do not already show.
  const wasActive = licenseStatusOf.lookup(lc) == LicenseState.ACTIVE;
  licenseStatusOf.remove(lc);
  licenseRecordOf.remove(lc);
  // A revoked licence must leave nothing behind. Without this, the pending
  // entry outlives the licence: state grows without bound, and a later
  // approveTransfer passes the member check then fails inside the record
  // lookup, so the error does not describe what happened.
  if (pendingTransferOf.member(lc)) { pendingTransferOf.remove(lc); }

  // AND IT MUST LEAVE THE TREE, or revocation would remove a licence from the maps
  // while leaving it presentable — proveLicense opens the tree, not the map, so a
  // leaf left behind is a revoked licence that still proves. Removing it is the
  // whole revocation as far as a verifier is concerned.
  if (wasActive) {
    const nullLeaf = default<Bytes<32>>;
    const roots = licenseReplaceLeaf(lc, nullLeaf, licenseSiblings(), licenseDirections());
    assert(disclose(roots[0]) == activeLicenseRoot,
           "That licence is not at the position given, or the path is invalid");
    activeLicenseRoot = disclose(roots[1]);
  }
}

/**
 * Move a record to a new secret, and retire the old one.
 *
 * Both sides are proved. The incoming commitment used to be an argument taken on
 * trust, which let a holder rotate "into" a commitment belonging to someone else —
 * naming a target is not the same as holding it.
 *
 * The retirement is the part that was missing. A secret cannot be un-known, so
 * rotating away from a compromised one did nothing on its own: the old secret went
 * on issuing licences, revoking them and pairing DNA, and the new record could not
 * revoke anything the old one had issued. Recording the rotation and having every
 * record-gated circuit consult it is what actually ends the old identity.
 *
 * This does NOT help a holder who has lost their secret — it requires that secret.
 * That case is `recoverRecordSecret`.
 */
export circuit rotateRecordSecret(newRecordCommitment: Bytes<32>): Bytes<32> {
  const old = disclose(commit(localGeneticSecret()));
  const fresh = disclose(newRecordCommitment);
  assert(old != fresh, "The new commitment must differ from the old one");
  assert(fresh == commit(incomingGeneticSecret()),
         "You must hold the secret behind the new commitment");
  assertLive(old);
  assert(!rotatedTo.member(fresh), "That commitment has itself been retired");

  anchorSeq.increment(1);
  lastRotatedFrom = old;
  lastRotatedTo = fresh;
  rotatedTo.insert(old, fresh);
  return old;
}

/**
 * Move a record whose primary secret is gone.
 *
 * The checklist item is that no role may be permanently lockable by a single lost
 * secret. Rotation does not satisfy it: rotation requires the secret. This does,
 * because it is gated by a different one, chosen when the record was anchored and
 * kept apart from the first.
 *
 * The recovery commitment is published at anchor time and cannot be added
 * afterwards — by the time a holder knows they need one, they no longer hold the
 * secret that would authorise adding it. A record anchored without one is
 * unrecoverable, and that is a property of when it was anchored rather than
 * something a holder can fix later.
 */
export circuit recoverRecordSecret(recordCommitment: Bytes<32>, newRecordCommitment: Bytes<32>): Bytes<32> {
  const rec = disclose(recordCommitment);
  assert(recoveryOf.member(rec), "This record was anchored without a recovery commitment");
  assert(recoveryOf.lookup(rec) == commit(recoverySecret()),
         "That is not the recovery secret for this record");
  assertLive(rec);

  const fresh = disclose(newRecordCommitment);
  assert(rec != fresh, "The new commitment must differ from the old one");
  assert(fresh == commit(incomingGeneticSecret()),
         "You must hold the secret behind the new commitment");

  anchorSeq.increment(1);
  lastRotatedFrom = rec;
  lastRotatedTo = fresh;
  rotatedTo.insert(rec, fresh);
  return rec;
}


/**
 * A licensee proves they hold a live licence, naming nothing.
 *
 * NO ARGUMENTS, DELIBERATELY. Every input here is a witness, and the only public
 * output is that the assertion held. What the chain sees is: somebody opened a leaf
 * of the current active-licence tree.
 *
 * What it used to see. The commitment was derived and then used as a key into
 * licenseStatusOf, and a map lookup puts its key in the public transcript.
 * licenseRecordOf maps that key straight to the issuing record, so every
 * presentation named the breeder — and because the key is the same key every time,
 * two presentations of one licence linked to each other and to every other
 * presentation of any licence from that breeder. The comment above this circuit
 * said it revealed no counterparty. It revealed the counterparty every time.
 *
 * Both halves still hold:
 *   · only the holder can pass — the leaf is rebuilt from their own secret, so
 *     opening a leaf requires knowing what is behind it;
 *   · only a LIVE licence can pass — the tree holds exactly the active set.
 *     countersignLicense inserts, revokeLicense removes, approveTransfer moves the
 *     leaf to the incoming party. A revoked licence has no leaf to open, and a
 *     pending one was never inserted.
 *
 * What it still leaks: that a presentation happened, and when. Unlinkable, not
 * invisible. Hiding the fact of a presentation is a different mechanism again.
 */
export circuit proveLicense(): [] {
  const leaf = licenseCommit(licenseSecret(), licenseRecord());
  // The comparison is disclosed — that is the proof's public statement — while the
  // leaf, the path and the position it sits at are not.
  assert(disclose(licenseMerkleRoot(leaf, licenseSiblings(), licenseDirections()) == activeLicenseRoot),
         "No live licence for that secret");
}

/**
 * Public status lookup for a live licence. THIS ONE NAMES THE ISSUER.
 *
 * It takes the licence commitment as a PUBLIC ARGUMENT, by design: the caller is
 * asking about a licence they already know, and a status lookup that hid which
 * licence it concerned would answer nothing. The map lookups below put that key in
 * the public transcript, and `licenseRecordOf` maps it straight to the issuing
 * record — so every call links a licence to the breeder who issued it, and repeated
 * calls about the same licence link to each other.
 *
 * NOT INTERCHANGEABLE WITH proveLicense, and the names invite exactly that mistake.
 * Picking by name, `licenseStatus` reads like the safe read-only one and
 * `proveLicense` like the heavyweight one. It is the other way round:
 *
 *   licenseStatus(lc)   asks a PUBLIC question — which licence, and therefore whose
 *   proveLicense()      takes no arguments at all and names nothing
 *
 * Use this to display or audit a licence whose identity is already in the open
 * between the parties. Use `proveLicense` whenever a holder is showing a stranger
 * that they hold something, which is the case that repeats and the case that links.
 *
 * The RETURNED state reaches the caller's own DApp and not the chain — a return
 * travels in the blinded communication commitment. So the answer is not public; the
 * question is. That is the opposite of the property a reader usually assumes from a
 * lookup, and it is why the old one-line comment calling this "privacy-safe" was
 * removed rather than reworded.
 */
export circuit licenseStatus(licenseCommitment: Bytes<32>): LicenseState {
  const lc = disclose(licenseCommitment);
  assert(licenseStatusOf.member(lc), "No such live license");
  return licenseStatusOf.lookup(lc);
}
