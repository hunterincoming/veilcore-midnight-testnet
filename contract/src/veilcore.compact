// Veilcore: on-chain provenance + licensing for plant genetics.
// SPDX-License-Identifier: Apache-2.0
//
// Only commitments (domain-separated hashes) are ever stored on-chain. Genetic
// preimages, license terms, and counterparties stay off-chain as private witnesses.
//
// STATE MODEL. Anchoring writes one recovery entry per record. Licensing holds only
// LIVE agreements; terminal licences are removed. The bound on licence state is
// economic, not structural: anyone can hold a secret, so anyone can issue licences
// to themselves and pay a fee per entry. The active-licence tree is the one
// structural limit: 65,536 concurrent active licences.
//
// Four maps grow permanently: `recoveryOf` (one entry per anchored record),
// `rotatedTo`, `originOf` and `headOf` (one entry each per rotation or recovery).
// That is the price of a lost secret not being final and a retired secret
// ceasing to work.
//
// IDENTITY. A record is an ORIGIN (a commitment nobody rotated into) or a SUCCESSOR
// (one a rotation or recovery moved to). Every successor points at its origin in
// `originOf`, and every rotated origin points at its current head in `headOf`. Control
// of a licence is decided by comparing ORIGINS, never by following one hop: a
// one-hop check lost control of every licence after the second rotation.
//
// SECURITY PASS 30 SEP 2026. Every circuit that acts for a record now DERIVES the
// caller's record from their secret rather than taking it as an argument; every
// licence secret is a witness rather than an argument; recovery overrides a thief
// who rotated first; licence entries are keyed by (licence, issuer) so a squatter
// cannot block an issue; and a licence presentation is bound to the issuing record
// and a verifier-chosen challenge. Each change has a regression test in
// contract/attack-30sep.mjs.

pragma language_version 0.23;

import CompactStandardLibrary;

// Lifecycle status for a license.
export enum LicenseState { NONE, PENDING, ACTIVE, REVOKED }

// Fixed single-slot fields. No growable container.
export ledger anchorSeq: Counter;
export ledger lastAnchor: Bytes<32>;
export ledger proofSeq: Counter;
export ledger batchSeq: Counter;
export ledger lastBatchRoot: Bytes<32>;
export ledger transferSeq: Counter;
export ledger pairSeq: Counter;
export ledger rotationSeq: Counter;
export ledger presentationSeq: Counter;

// A value a verifier needs has to be written to the ledger: a circuit's return value
// travels in the blinded communication commitment and reaches only the caller.
// Separate cells so no cell mixes proved and unproved values.
export ledger lastOwnershipProof: Bytes<32>;
export ledger lastPairedRecord: Bytes<32>;
export ledger lastPairedDna: Bytes<32>;
export ledger lastRotatedFrom: Bytes<32>;
export ledger lastRotatedTo: Bytes<32>;
export ledger lastPresentation: Bytes<32>;
// Published on activation so anyone can rebuild the active-licence tree: the ledger
// holds only its root, and a holder needs every other leaf to build their own path.
export ledger lastActivatedLicense: Bytes<32>;
export ledger lastActivatedRecord: Bytes<32>;

/** Retired record -> the record it moved to. Set once, never cleared. */
export ledger rotatedTo: Map<Bytes<32>, Bytes<32>>;
/** Successor -> the origin record it descends from. */
export ledger originOf: Map<Bytes<32>, Bytes<32>>;
/** Rotated origin -> its current live head. What recovery retires. */
export ledger headOf: Map<Bytes<32>, Bytes<32>>;
/** Origin record -> its recovery commitment. Set at anchor time. */
export ledger recoveryOf: Map<Bytes<32>, Bytes<32>>;

// Licence entries are keyed by licenseKey(licence, issuing record), not by the
// licence commitment alone. With the commitment alone as key, anyone who saw a
// pending issue could insert the same commitment under their own record first
// and the breeder's issue failed with "already exists" for as long as they kept
// doing it. The issuer is inside the key, so a squatter's entry is a different
// entry and blocks nothing.
export ledger licenseStatusOf: Map<Bytes<32>, LicenseState>;
/** Licence key -> the incoming party's licence commitment. */
export ledger pendingTransferOf: Map<Bytes<32>, Bytes<32>>;

// The caller's private genetic secret, supplied by the wallet's private state.
witness localGeneticSecret(): Bytes<32>;
/** The secret a rotation or recovery is moving TO. Proved, not taken on trust. */
witness incomingGeneticSecret(): Bytes<32>;
/** The recovery secret: chosen at anchor time, kept apart, ideally offline. */
witness recoverySecret(): Bytes<32>;
/**
 * The verifier's challenge for a licence presentation.
 *
 * MUST be 32 random bytes chosen by the verifier and never published. The
 * presentation discloses hash(record, challenge); a public or guessable
 * challenge lets anyone test every issuing record against it and learn whose
 * licence was shown.
 */
witness presentationChallenge(): Bytes<32>;

// Domain-separated commitment to a genetic secret. RECORDS ONLY.
export circuit commit(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilcore:commit"), secret]);
}

/**
 * Commitment to a RECOVERY secret. Its own domain.
 *
 * Recovery commitments used the record tag, which made every recovery commitment a
 * valid record commitment too: the holder of a recovery secret could anchor it as a
 * record of its own and issue licences under it. Two kinds of thing, two tags.
 */
export circuit recoveryCommit(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilcore:recover"), secret]);
}

/** Commitment to a licence secret, bound to the record it is issued against. */
export circuit licenseCommit(secret: Bytes<32>, recordCommitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:license"), secret, recordCommitment]);
}

/** The map key for a licence: the licence AND the record that issued it. */
export circuit licenseKey(licenseCommitment: Bytes<32>, recordCommitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:lickey"), licenseCommitment, recordCommitment]);
}

/** What a licence presentation publishes. Only someone knowing the challenge can check it. */
export circuit presentationTag(recordCommitment: Bytes<32>, challenge: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:present"), recordCommitment, challenge]);
}

// ─────────────────────────────────────────────────── the active-licence tree
//
// GENERATED, like lineage.compact's fold, and for the same reason: Compact has no
// loops, so a depth-16 tree is 16 unrolled steps and 32 for a replacement. They were
// produced mechanically rather than typed.
//
// WHY THERE IS A TREE AT ALL. proveLicense used to look the licence commitment up
// in licenseStatusOf. A map lookup puts its key in the public transcript, and
// licenseRecordOf maps that key to the issuing record — so every presentation of a
// licence named the breeder, and two presentations of the same licence were
// trivially linkable to each other. The comment above it claimed the opposite.
//
// A presentation against a ROOT names nothing. The leaf is the licence commitment,
// the path is a private witness, and the only public statement is that some leaf in
// the current tree was opened by someone who knows the secret behind it.
//
// POSITIONS ARE NOT DERIVED from the commitment, unlike the obligation tree's slots.
// Nothing needs them to be: an insert proves the slot it targets is empty, and a
// removal proves the leaf it names is where it says. Leaving position free means no
// birthday bound and no grinding target — 65536 concurrent ACTIVE licences, all of
// them usable, rather than a collision becoming likely in the hundreds.
//
// Capacity is concurrent, not cumulative: revocation and assignment free slots.

export ledger activeLicenseRoot: Bytes<32>;

/**
 * The licensee's licence secret, and the record it was issued against.
 *
 * Witnesses rather than arguments, because an argument to proveLicense is a public
 * value and naming either one is the whole defect.
 */
witness licenseSecret(): Bytes<32>;
witness licenseRecord(): Bytes<32>;
witness licenseSiblings(): Vector<16, Bytes<32>>;
witness licenseDirections(): Vector<16, Boolean>;

// Its own domain tag. Record commitments, licence commitments and tree nodes are
// three kinds of thing, and two of them sharing a tag is what let a licence secret
// be loaded as a genetic secret and anchored as a record of its own.
export circuit licenseNode(node: Bytes<32>, sibling: Bytes<32>, siblingIsLeft: Boolean): Bytes<32> {
  const left = siblingIsLeft ? sibling : node;
  const right = siblingIsLeft ? node : sibling;
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:licnode"), left, right]);
}

export circuit licenseMerkleRoot(
  leaf: Bytes<32>,
  siblings: Vector<16, Bytes<32>>,
  dirs: Vector<16, Boolean>,
): Bytes<32> {
  const n0 = licenseNode(leaf, siblings[0], dirs[0]);
  const n1 = licenseNode(n0, siblings[1], dirs[1]);
  const n2 = licenseNode(n1, siblings[2], dirs[2]);
  const n3 = licenseNode(n2, siblings[3], dirs[3]);
  const n4 = licenseNode(n3, siblings[4], dirs[4]);
  const n5 = licenseNode(n4, siblings[5], dirs[5]);
  const n6 = licenseNode(n5, siblings[6], dirs[6]);
  const n7 = licenseNode(n6, siblings[7], dirs[7]);
  const n8 = licenseNode(n7, siblings[8], dirs[8]);
  const n9 = licenseNode(n8, siblings[9], dirs[9]);
  const n10 = licenseNode(n9, siblings[10], dirs[10]);
  const n11 = licenseNode(n10, siblings[11], dirs[11]);
  const n12 = licenseNode(n11, siblings[12], dirs[12]);
  const n13 = licenseNode(n12, siblings[13], dirs[13]);
  const n14 = licenseNode(n13, siblings[14], dirs[14]);
  const n15 = licenseNode(n14, siblings[15], dirs[15]);
  return n15;
}

// Verify the current leaf and compute the replacement in one traversal: the
// siblings are the same for both, so folding twice would double the constraint
// count for nothing. Returns [old root, new root]; the caller asserts the old one.
export circuit licenseReplaceLeaf(
  oldLeaf: Bytes<32>,
  newLeaf: Bytes<32>,
  siblings: Vector<16, Bytes<32>>,
  dirs: Vector<16, Boolean>,
): Vector<2, Bytes<32>> {
  const o0 = licenseNode(oldLeaf, siblings[0], dirs[0]);
  const w0 = licenseNode(newLeaf, siblings[0], dirs[0]);
  const o1 = licenseNode(o0, siblings[1], dirs[1]);
  const w1 = licenseNode(w0, siblings[1], dirs[1]);
  const o2 = licenseNode(o1, siblings[2], dirs[2]);
  const w2 = licenseNode(w1, siblings[2], dirs[2]);
  const o3 = licenseNode(o2, siblings[3], dirs[3]);
  const w3 = licenseNode(w2, siblings[3], dirs[3]);
  const o4 = licenseNode(o3, siblings[4], dirs[4]);
  const w4 = licenseNode(w3, siblings[4], dirs[4]);
  const o5 = licenseNode(o4, siblings[5], dirs[5]);
  const w5 = licenseNode(w4, siblings[5], dirs[5]);
  const o6 = licenseNode(o5, siblings[6], dirs[6]);
  const w6 = licenseNode(w5, siblings[6], dirs[6]);
  const o7 = licenseNode(o6, siblings[7], dirs[7]);
  const w7 = licenseNode(w6, siblings[7], dirs[7]);
  const o8 = licenseNode(o7, siblings[8], dirs[8]);
  const w8 = licenseNode(w7, siblings[8], dirs[8]);
  const o9 = licenseNode(o8, siblings[9], dirs[9]);
  const w9 = licenseNode(w8, siblings[9], dirs[9]);
  const o10 = licenseNode(o9, siblings[10], dirs[10]);
  const w10 = licenseNode(w9, siblings[10], dirs[10]);
  const o11 = licenseNode(o10, siblings[11], dirs[11]);
  const w11 = licenseNode(w10, siblings[11], dirs[11]);
  const o12 = licenseNode(o11, siblings[12], dirs[12]);
  const w12 = licenseNode(w11, siblings[12], dirs[12]);
  const o13 = licenseNode(o12, siblings[13], dirs[13]);
  const w13 = licenseNode(w12, siblings[13], dirs[13]);
  const o14 = licenseNode(o13, siblings[14], dirs[14]);
  const w14 = licenseNode(w13, siblings[14], dirs[14]);
  const o15 = licenseNode(o14, siblings[15], dirs[15]);
  const w15 = licenseNode(w14, siblings[15], dirs[15]);
  return [o15, w15];
}

/**
 * Start the licence tree at the root of an empty tree.
 *
 * veilcore had no constructor. Adding a tree without one would have repeated
 * finding 1 exactly: the root would start at the default Bytes<32>, which is an
 * unset cell rather than a tree, no fold could ever reproduce it, and every
 * countersignature and every licence proof would fail in every deployment.
 */
constructor() {
  const nullLeaf = default<Bytes<32>>;
  const l0 = licenseNode(nullLeaf, nullLeaf, false);
  const l1 = licenseNode(l0, l0, false);
  const l2 = licenseNode(l1, l1, false);
  const l3 = licenseNode(l2, l2, false);
  const l4 = licenseNode(l3, l3, false);
  const l5 = licenseNode(l4, l4, false);
  const l6 = licenseNode(l5, l5, false);
  const l7 = licenseNode(l6, l6, false);
  const l8 = licenseNode(l7, l7, false);
  const l9 = licenseNode(l8, l8, false);
  const l10 = licenseNode(l9, l9, false);
  const l11 = licenseNode(l10, l10, false);
  const l12 = licenseNode(l11, l11, false);
  const l13 = licenseNode(l12, l12, false);
  const l14 = licenseNode(l13, l13, false);
  const l15 = licenseNode(l14, l14, false);
  activeLicenseRoot = l15;
}

// ─────────────────────────────────────────────────────────────── identity

/** Refuse a record that has been rotated away from. */
export circuit assertLive(recordCommitment: Bytes<32>): [] {
  assert(!rotatedTo.member(disclose(recordCommitment)),
         "This record was rotated to a new secret; act under the new one");
}

/**
 * The caller's record, DERIVED from their secret and required to be live.
 *
 * Never an argument. A circuit that takes the caller's record as an argument and
 * compares it to their secret is correct only as long as nobody edits the comparison
 * away; deriving it leaves nothing to get wrong.
 */
circuit liveSelf(): Bytes<32> {
  const me = disclose(commit(localGeneticSecret()));
  assertLive(me);
  return me;
}

/** The origin a record descends from; an origin is its own. */
circuit originFor(record: Bytes<32>): Bytes<32> {
  return originOf.member(record) ? originOf.lookup(record) : record;
}

/** Refuse unless `me` is the same identity as `issuer`, across any number of rotations. */
circuit assertSameIdentity(me: Bytes<32>, issuer: Bytes<32>): [] {
  assert(originFor(me) == originFor(issuer),
         "Only the issuing record, or the record it was rotated or recovered to, can do this");
}

/**
 * A rotation or recovery target must be a commitment with no history at all.
 *
 * Moving into an existing successor would overwrite its origin and orphan every
 * licence it controlled; moving into an anchored or retired record would merge two
 * identities. A target nobody has used has none of those problems.
 */
circuit assertUnused(record: Bytes<32>): [] {
  assert(!rotatedTo.member(record), "That commitment has been retired");
  assert(!originOf.member(record), "That commitment is already a successor");
  assert(!recoveryOf.member(record), "That commitment is already an anchored record");
  assert(!headOf.member(record), "That commitment is already an origin with history");
}

/** Move identity `origin` from its current head to `fresh`. */
circuit moveHead(origin: Bytes<32>, head: Bytes<32>, fresh: Bytes<32>): [] {
  rotatedTo.insert(head, fresh);
  originOf.insert(fresh, origin);
  headOf.insert(origin, fresh);
  rotationSeq.increment(1);
  lastRotatedFrom = head;
  lastRotatedTo = fresh;
}

// ─────────────────────────────────────────────────────────────── records

/**
 * Anchor a record: the caller's own, derived from their secret.
 *
 * The recovery commitment is fixed now: by the time a holder needs it they no longer
 * hold the secret that would authorise adding it. Build it with recoveryCommit, from
 * a secret that is NOT the genetic secret and is stored apart from it.
 */
export circuit anchor(recoveryCommitment: Bytes<32>): [] {
  const c = liveSelf();
  assert(!originOf.member(c), "This commitment is a successor; its origin is already anchored");
  assert(!recoveryOf.member(c), "This record is already anchored");
  const rcv = disclose(recoveryCommitment);
  assert(rcv != c, "The recovery commitment must differ from the record");
  anchorSeq.increment(1);
  lastAnchor = c;
  recoveryOf.insert(c, rcv);
}

/**
 * Anchor a batch root. UNAUTHENTICATED, deliberately: anyone may anchor any root.
 *
 * A root proves that a set of commitments existed at a time, not who held them. A
 * commitment is visible in its own pending anchor transaction, so anyone can put it
 * in a batch in the same block. A batch inclusion is therefore never a possession
 * proof, and `lastBatchRoot` is a scratch slot, never evidence: check inclusion
 * against the root in the transaction the holder cites.
 */
export circuit anchorBatch(root: Bytes<32>): [] {
  const r = disclose(root);
  batchSeq.increment(1);
  lastBatchRoot = r;
}

/**
 * Prove present possession: a dated transaction only the holder of a LIVE record's
 * secret could produce. A retired secret is refused: after a rotation away from a
 * stolen secret, the thief must not go on producing possession proofs.
 */
export circuit proveOwnership(): Bytes<32> {
  const c = liveSelf();
  proofSeq.increment(1);
  lastOwnershipProof = c;
  return c;
}

/** Bind a DNA report fingerprint to the caller's own live record. */
export circuit pairDna(dnaCommitment: Bytes<32>): Bytes<32> {
  const rc = liveSelf();
  const dc = disclose(dnaCommitment);
  pairSeq.increment(1);
  lastPairedRecord = rc;
  lastPairedDna = dc;
  return rc;
}

/**
 * Move the caller's live record to a new secret, and retire the old one.
 *
 * The identity (origin) carries over, so every licence issued under any earlier
 * record of this identity stays under control, and the recovery commitment on the
 * origin keeps protecting the new head.
 */
export circuit rotateRecordSecret(newRecordCommitment: Bytes<32>): Bytes<32> {
  const old = liveSelf();
  const fresh = disclose(newRecordCommitment);
  assert(old != fresh, "The new commitment must differ from the old one");
  assert(fresh == commit(incomingGeneticSecret()),
         "You must hold the secret behind the new commitment");
  assertUnused(fresh);
  moveHead(originFor(old), old, fresh);
  return old;
}

/**
 * Move an identity using its recovery secret. Works whether or not the identity has
 * been rotated since, INCLUDING by a thief.
 *
 * The recovery secret is the master key. Recovery used to require the record to be
 * live, so a thief who stole the primary secret and rotated first kept the record
 * for good, and recovery only ever helped against loss. Now recovery retires whatever
 * the current head is, thief's or not. The flip side: whoever holds the recovery
 * secret controls the record, so it belongs offline.
 */
export circuit recoverRecordSecret(recordCommitment: Bytes<32>, newRecordCommitment: Bytes<32>): Bytes<32> {
  const origin = disclose(recordCommitment);
  assert(recoveryOf.member(origin), "Recovery is only for an anchored origin record");
  assert(recoveryOf.lookup(origin) == recoveryCommit(recoverySecret()),
         "That is not the recovery secret for this record");
  const fresh = disclose(newRecordCommitment);
  assert(fresh == commit(incomingGeneticSecret()),
         "You must hold the secret behind the new commitment");
  assertUnused(fresh);
  const head = headOf.member(origin) ? headOf.lookup(origin) : origin;
  moveHead(origin, head, fresh);
  return head;
}

/** Replace a recovery commitment, e.g. after the recovery secret may have leaked. */
export circuit replaceRecoveryCommitment(recordCommitment: Bytes<32>, newRecoveryCommitment: Bytes<32>): [] {
  const origin = disclose(recordCommitment);
  assert(recoveryOf.member(origin), "Recovery is only for an anchored origin record");
  assert(recoveryOf.lookup(origin) == recoveryCommit(recoverySecret()),
         "That is not the recovery secret for this record");
  const next = disclose(newRecoveryCommitment);
  assert(next != recoveryOf.lookup(origin), "The new recovery commitment must differ");
  recoveryOf.insert(origin, next);
}

// ─────────────────────────────────────────────────────────────── licences

/**
 * Issue a licence against the caller's own live record. Starts PENDING.
 *
 * THE LICENSEE GENERATES THE LICENCE SECRET and hands over only licenseCommit(secret,
 * issuer record). The contract cannot check this; an issuer who knows the secret can
 * also countersign, which is a licence issued to nobody.
 */
export circuit issueLicense(licenseCommitment: Bytes<32>): [] {
  const me = liveSelf();
  const lc = disclose(licenseCommitment);
  const k = licenseKey(lc, me);
  assert(!licenseStatusOf.member(k), "License already exists");
  licenseStatusOf.insert(k, LicenseState.PENDING);
}

/**
 * The licensee accepts a pending licence. The secret is a witness (licenseSecret),
 * never an argument; the record is the issuer's, which is public.
 */
export circuit countersignLicense(recordCommitment: Bytes<32>): [] {
  const rc = disclose(recordCommitment);
  const lc = licenseCommit(licenseSecret(), rc);
  const k = disclose(licenseKey(lc, rc));
  assert(licenseStatusOf.member(k), "No such license against that record");
  assert(licenseStatusOf.lookup(k) == LicenseState.PENDING, "License is not pending");
  licenseStatusOf.insert(k, LicenseState.ACTIVE);
  lastActivatedLicense = disclose(lc);
  lastActivatedRecord = rc;

  // Activation puts the licence in the tree: the tree holds exactly the set
  // proveLicense may open.
  const nullLeaf = default<Bytes<32>>;
  const roots = licenseReplaceLeaf(nullLeaf, lc, licenseSiblings(), licenseDirections());
  assert(disclose(roots[0]) == activeLicenseRoot,
         "That licence tree slot is not empty, or the path is invalid");
  activeLicenseRoot = disclose(roots[1]);
}

/**
 * The holder proposes moving the licence to a new party. The issuer must approve.
 *
 * The incoming party generates their own secret and hands over only
 * licenseCommit(theirSecret, issuer record).
 */
export circuit proposeTransfer(recordCommitment: Bytes<32>, newLicenseCommitment: Bytes<32>): [] {
  const rc = disclose(recordCommitment);
  const k = disclose(licenseKey(licenseCommit(licenseSecret(), rc), rc));
  assert(licenseStatusOf.member(k), "No such license against that record");
  assert(licenseStatusOf.lookup(k) == LicenseState.ACTIVE, "Only an active license can be transferred");
  assert(!pendingTransferOf.member(k), "A transfer is already proposed for this license");
  const nlc = disclose(newLicenseCommitment);
  assert(!licenseStatusOf.member(licenseKey(nlc, rc)), "That licence commitment is already in use");
  transferSeq.increment(1);
  pendingTransferOf.insert(k, nlc);
}

/**
 * The issuer, or whoever the issuer's identity now lives under, approves a transfer
 * to the party they name.
 *
 * `issuingRecord` is the record the licence was issued under, which after a rotation
 * is not the caller's. It is checked, not trusted: it has to be the same identity as
 * the caller, and the licence has to exist under it.
 */
export circuit approveTransfer(licenseCommitment: Bytes<32>, issuingRecord: Bytes<32>, expectedNewLicense: Bytes<32>): [] {
  const me = liveSelf();
  const rc = disclose(issuingRecord);
  assertSameIdentity(me, rc);
  const lc = disclose(licenseCommitment);
  const k = licenseKey(lc, rc);
  assert(pendingTransferOf.member(k), "No transfer proposed for this license");
  // The issuer approves a PARTY, not whatever is pending at execution time.
  const nlc = pendingTransferOf.lookup(k);
  assert(nlc == disclose(expectedNewLicense), "The pending recipient is not the one you approved");
  const nk = licenseKey(nlc, rc);
  assert(!licenseStatusOf.member(nk), "That licence commitment is already in use");

  // The old licence ends and the same agreement continues under a key the outgoing
  // party has never seen. It stays under the ORIGINAL issuing record, because the
  // incoming party built their commitment against it.
  licenseStatusOf.remove(k);
  pendingTransferOf.remove(k);
  licenseStatusOf.insert(nk, LicenseState.ACTIVE);
  transferSeq.increment(1);

  const roots = licenseReplaceLeaf(lc, nlc, licenseSiblings(), licenseDirections());
  assert(disclose(roots[0]) == activeLicenseRoot,
         "That licence is not at the position given, or the path is invalid");
  activeLicenseRoot = disclose(roots[1]);
}

/** The holder withdraws their own proposal. Proposals do not expire on their own. */
export circuit withdrawTransfer(recordCommitment: Bytes<32>): [] {
  const rc = disclose(recordCommitment);
  const k = disclose(licenseKey(licenseCommit(licenseSecret(), rc), rc));
  assert(pendingTransferOf.member(k), "No transfer proposed for this license");
  pendingTransferOf.remove(k);
  transferSeq.increment(1);
}

/** The issuer, or its successor across any number of rotations, revokes a licence. */
export circuit revokeLicense(licenseCommitment: Bytes<32>, issuingRecord: Bytes<32>): [] {
  const me = liveSelf();
  const rc = disclose(issuingRecord);
  assertSameIdentity(me, rc);
  const lc = disclose(licenseCommitment);
  const k = licenseKey(lc, rc);
  assert(licenseStatusOf.member(k), "No such license");
  // Only an ACTIVE licence has a leaf; a pending one was never accepted.
  const wasActive = licenseStatusOf.lookup(k) == LicenseState.ACTIVE;
  licenseStatusOf.remove(k);
  if (pendingTransferOf.member(k)) { pendingTransferOf.remove(k); }
  // Leaving the leaf would leave a revoked licence that still proves.
  if (wasActive) {
    const nullLeaf = default<Bytes<32>>;
    const roots = licenseReplaceLeaf(lc, nullLeaf, licenseSiblings(), licenseDirections());
    assert(disclose(roots[0]) == activeLicenseRoot,
           "That licence is not at the position given, or the path is invalid");
    activeLicenseRoot = disclose(roots[1]);
  }
}

/**
 * A licensee proves to ONE verifier that they hold a live licence from ONE record.
 *
 * All inputs are witnesses. Publishes presentationTag(record, challenge) and nothing
 * else. The verifier, who chose the challenge and knows which record they asked
 * about, recomputes the tag and finds it in this transaction. To anyone else it is
 * a random value: it names no record and links to no other presentation.
 *
 * What the old version proved: that SOME leaf in the global tree was opened. It
 * named no record, so a licence for one variety passed a check about another, and it
 * bound no challenge, so every successful presentation looked identical and anyone
 * could point a verifier at someone else's.
 *
 * Still true: a presentation is visible as having happened, and when. And a licensee
 * who hands their challenge to another licensee of the same record can have them
 * present instead; nothing short of identifying the licensee stops that.
 */
export circuit proveLicense(): [] {
  const record = licenseRecord();
  const leaf = licenseCommit(licenseSecret(), record);
  assert(disclose(licenseMerkleRoot(leaf, licenseSiblings(), licenseDirections()) == activeLicenseRoot),
         "No live licence for that secret");
  presentationSeq.increment(1);
  lastPresentation = disclose(presentationTag(record, presentationChallenge()));
}

/**
 * Public status lookup. THIS ONE NAMES THE LICENCE AND ITS ISSUER, both as public
 * arguments, and repeated calls link. Use proveLicense to show a stranger a licence.
 */
export circuit licenseStatus(licenseCommitment: Bytes<32>, issuingRecord: Bytes<32>): LicenseState {
  const k = licenseKey(disclose(licenseCommitment), disclose(issuingRecord));
  assert(licenseStatusOf.member(k), "No such live license");
  return licenseStatusOf.lookup(k);
}
