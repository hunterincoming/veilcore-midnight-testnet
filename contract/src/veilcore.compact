// Veilcore: on-chain provenance + licensing for plant genetics.
// SPDX-License-Identifier: Apache-2.0
//
// Only commitments (domain-separated hashes) are ever stored on-chain. Genetic
// preimages, licence terms and counterparties stay off-chain as private witnesses.
//
// IDENTITY. A record is an ORIGIN (a commitment nobody moved to) or a SUCCESSOR (one a
// rotation or recovery moved to). Every successor points at its origin in `originOf`,
// and every moved origin points at its CURRENT HEAD in `headOf`. A record is live only
// if it is its identity's current head. Authority over a licence is decided by
// comparing origins, so it survives any number of rotations.
//
// LICENCES. Entries are keyed by licenseKey(licence, issuing record), and the same key
// is the leaf of the active-licence tree, a ledger HistoricMerkleTree. Writers never
// supply a path: the ledger places and clears leaves itself, so revocation and transfer
// cannot be blocked by unrelated tree traffic. Readers (presentations) prove a path
// against any root since the last revocation or transfer; activations do not
// invalidate them.
//
// STATE. Licence state is bounded by live agreements, economically: anyone can hold a
// secret and issue licences to themselves at a fee per entry. The tree holds 2^24
// activations over the contract's life. Four identity maps grow permanently (one entry
// per anchor, and per rotation or recovery): that is the price of a lost or stolen
// secret not being final and a retired one ceasing to work.
//
// SECURITY PASS 30 SEP 2026, two rounds (the second an independent review). Every
// change below was first demonstrated as an attack on the previous build; regression
// tests in contract/attack-30sep.mjs.
//   · control of licences follows the origin across any number of rotations
//   · recovery overrides a thief, survives rotation, has its own hash domain, and
//     cannot be blocked by the thief rotating again (it no longer reads the head)
//   · every circuit derives its caller from their secret; licence secrets are witnesses
//   · licence entries and tree leaves are keyed by (licence, issuer): a squatter
//     cannot block an issue, a transfer cannot forge a licence from another issuer,
//     and one commitment cannot sit in the tree twice to outlive its revocation
//   · a presentation is bound to the issuing record and a verifier-chosen challenge
//   · revocation and transfer need no tree path, so nobody can starve them
//   · every argument is validated; the all-zero recovery secret is refused

pragma language_version 0.23;

import CompactStandardLibrary;

export enum LicenseState { NONE, PENDING, ACTIVE, REVOKED }

// ─────────────────────────────────────────────────────────────── state

export ledger anchorSeq: Counter;
export ledger proofSeq: Counter;
export ledger batchSeq: Counter;
export ledger pairSeq: Counter;
export ledger rotationSeq: Counter;
export ledger transferSeq: Counter;
export ledger presentationSeq: Counter;

// A value a verifier needs has to be written to the ledger: a circuit's return value
// travels in the blinded communication commitment and reaches only the caller. One
// cell per meaning, so no cell mixes proved and unproved values.
export ledger lastAnchor: Bytes<32>;
export ledger lastBatchRoot: Bytes<32>;
export ledger lastOwnershipProof: Bytes<32>;
export ledger lastPairedRecord: Bytes<32>;
export ledger lastPairedDna: Bytes<32>;
export ledger lastRotatedFrom: Bytes<32>;
export ledger lastRotatedTo: Bytes<32>;
export ledger lastRecoveredOrigin: Bytes<32>;
export ledger lastPresentation: Bytes<32>;
export ledger lastActivatedLicense: Bytes<32>;
export ledger lastActivatedRecord: Bytes<32>;

/** Retired record -> the record a ROTATION moved it to. History for verifiers. */
export ledger rotatedTo: Map<Bytes<32>, Bytes<32>>;
/** Successor -> the origin it descends from. */
export ledger originOf: Map<Bytes<32>, Bytes<32>>;
/** Moved origin -> its current live head. The one source of truth for liveness. */
export ledger headOf: Map<Bytes<32>, Bytes<32>>;
/** Origin -> its recovery commitment. Set at anchor time. */
export ledger recoveryOf: Map<Bytes<32>, Bytes<32>>;

/** licenseKey(licence, issuer) -> state. Live licences only. */
export ledger licenseStatusOf: Map<Bytes<32>, LicenseState>;
/** licenseKey -> the incoming party's licence commitment. */
export ledger pendingTransferOf: Map<Bytes<32>, Bytes<32>>;

/** Leaves are licenseKey(licence, issuer) of ACTIVE licences. */
export ledger activeLicenses: HistoricMerkleTree<24, Bytes<32>>;
/** licenseKey -> its leaf index, so revocation and transfer need no path. */
export ledger licenseSlotOf: Map<Bytes<32>, Uint<64>>;
/** Next unused leaf index. Leaves are never reused: capacity is 2^24 activations. */
export ledger nextLicenseSlot: Counter;

// ─────────────────────────────────────────────────────────────── witnesses

/** The caller's record secret. */
witness localGeneticSecret(): Bytes<32>;
/** The secret a rotation or recovery moves TO. Proved, not taken on trust. */
witness incomingGeneticSecret(): Bytes<32>;
/** The recovery secret: chosen at anchor time, kept apart, ideally offline. */
witness recoverySecret(): Bytes<32>;
/** The licensee's licence secret, and the record the licence was issued against. */
witness licenseSecret(): Bytes<32>;
witness licenseRecord(): Bytes<32>;
/** The licence's path in activeLicenses, from findPathForLeaf. Never published. */
witness licensePath(): MerkleTreePath<24, Bytes<32>>;
/**
 * The verifier's challenge. 32 random bytes chosen by the VERIFIER, used once and
 * never published: a public or guessable challenge lets anyone test every issuing
 * record against the tag and learn whose licence was shown.
 */
witness presentationChallenge(): Bytes<32>;

// ─────────────────────────────────────────────────────────────── pure

/** Commitment to a record secret. RECORDS ONLY: every kind of value has its own tag. */
export circuit commit(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilcore:commit"), secret]);
}

/** Commitment to a recovery secret. Never also a valid record commitment. */
export circuit recoveryCommit(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilcore:recover"), secret]);
}

/** Commitment to a licence secret, bound to the record it is issued against. */
export circuit licenseCommit(secret: Bytes<32>, recordCommitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:license"), secret, recordCommitment]);
}

/** A licence entry and tree leaf: the licence AND the record that issued it. */
export circuit licenseKey(licenseCommitment: Bytes<32>, recordCommitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:lickey"), licenseCommitment, recordCommitment]);
}

/** What a presentation publishes. Checkable only by whoever holds the challenge. */
export circuit presentationTag(recordCommitment: Bytes<32>, challenge: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "veilcore:present"), recordCommitment, challenge]);
}

// ─────────────────────────────────────────────────────────────── identity

/** The origin a record descends from; an origin is its own. */
circuit originFor(record: Bytes<32>): Bytes<32> {
  return originOf.member(record) ? originOf.lookup(record) : record;
}

/**
 * Refuse unless `record` is its identity's current head.
 *
 * Liveness is read from headOf, not from a list of retirements. Recovery can then
 * move an identity by writing the new head WITHOUT reading the old one, which is what
 * stops a thief blocking recovery: when recovery read the head, the thief rotated
 * again before it landed and the recovery failed, every time.
 */
export circuit assertLive(recordCommitment: Bytes<32>): [] {
  const r = disclose(recordCommitment);
  const o = originFor(r);
  const live = headOf.member(o) ? headOf.lookup(o) == r : o == r;
  assert(live, "This record was rotated or recovered to a new secret; act under the new one");
}

/** The caller's record, derived from their secret, and required to be live. */
circuit liveSelf(): Bytes<32> {
  const me = disclose(commit(localGeneticSecret()));
  assertLive(me);
  return me;
}

/** Refuse unless `me` is the same identity as `issuer`, across any number of moves. */
circuit assertSameIdentity(me: Bytes<32>, issuer: Bytes<32>): [] {
  assert(originFor(me) == originFor(issuer),
         "Only the issuing record, or the record it was rotated or recovered to, can do this");
}

/**
 * A rotation or recovery target must have no history: moving into an existing
 * successor would overwrite its origin and orphan the licences under it, and moving
 * into an anchored or moved record would merge two identities.
 */
circuit assertUnused(record: Bytes<32>): [] {
  assert(!rotatedTo.member(record), "That commitment has been retired");
  assert(!originOf.member(record), "That commitment is already a successor");
  assert(!recoveryOf.member(record), "That commitment is already an anchored record");
  assert(!headOf.member(record), "That commitment is already an origin with history");
}

/** Refuse a recovery commitment nobody could have chosen by accident. */
circuit assertUsableRecovery(rcv: Bytes<32>): [] {
  assert(rcv != default<Bytes<32>>, "The recovery commitment cannot be empty");
  assert(rcv != recoveryCommit(default<Bytes<32>>),
         "That is the recovery commitment of the all-zero secret, which anyone can use");
}

// ─────────────────────────────────────────────────────────────── records

/**
 * Anchor the caller's own record, with a recovery commitment fixed now: by the time a
 * holder needs one, they no longer hold the secret that would authorise adding it.
 * Build it with recoveryCommit from a secret that is NOT the genetic secret.
 */
export circuit anchor(recoveryCommitment: Bytes<32>): [] {
  const c = liveSelf();
  assert(!originOf.member(c), "This commitment is a successor; anchor happens before rotation");
  assert(!recoveryOf.member(c), "This record is already anchored");
  const rcv = disclose(recoveryCommitment);
  assertUsableRecovery(rcv);
  anchorSeq.increment(1);
  lastAnchor = c;
  recoveryOf.insert(c, rcv);
}

/**
 * Anchor a batch root. UNAUTHENTICATED, deliberately. A root proves a set of
 * commitments existed at a time, not who held them: a commitment is visible in its
 * own pending anchor, so anyone can put it in a batch in the same block. Never treat a
 * batch inclusion as possession, and never treat lastBatchRoot as evidence.
 */
export circuit anchorBatch(root: Bytes<32>): [] {
  const r = disclose(root);
  assert(r != default<Bytes<32>>, "The batch root cannot be empty");
  batchSeq.increment(1);
  lastBatchRoot = r;
}

/** Prove present possession of a LIVE record. A retired secret proves nothing. */
export circuit proveOwnership(): Bytes<32> {
  const c = liveSelf();
  proofSeq.increment(1);
  lastOwnershipProof = c;
  return c;
}

/** Bind a DNA report fingerprint to the caller's own live record. */
export circuit pairDna(dnaCommitment: Bytes<32>): Bytes<32> {
  const rc = liveSelf();
  const dc = disclose(dnaCommitment);
  assert(dc != default<Bytes<32>>, "The DNA fingerprint cannot be empty");
  pairSeq.increment(1);
  lastPairedRecord = rc;
  lastPairedDna = dc;
  return rc;
}

/**
 * Move the caller's live record to a new secret. Only an ANCHORED identity rotates:
 * rotating an unanchored one produced a successor that could never be anchored or
 * recovered.
 */
export circuit rotateRecordSecret(newRecordCommitment: Bytes<32>): Bytes<32> {
  const old = liveSelf();
  const origin = originFor(old);
  assert(recoveryOf.member(origin), "Anchor this record before rotating it");
  const fresh = disclose(newRecordCommitment);
  assert(old != fresh, "The new commitment must differ from the old one");
  assert(fresh == commit(incomingGeneticSecret()), "You must hold the secret behind the new commitment");
  assertUnused(fresh);
  rotatedTo.insert(old, fresh);
  originOf.insert(fresh, origin);
  headOf.insert(origin, fresh);
  rotationSeq.increment(1);
  lastRotatedFrom = old;
  lastRotatedTo = fresh;
  return old;
}

/**
 * Move an identity with its recovery secret, whoever holds the current head —
 * including a thief. Writes the new head WITHOUT reading the old one, so rotating
 * again cannot make it fail. Whoever holds the recovery secret controls the record,
 * so it belongs offline.
 */
export circuit recoverRecordSecret(recordCommitment: Bytes<32>, newRecordCommitment: Bytes<32>): [] {
  const origin = disclose(recordCommitment);
  assert(recoveryOf.member(origin), "Recovery is only for an anchored origin record");
  assert(recoveryOf.lookup(origin) == recoveryCommit(recoverySecret()),
         "That is not the recovery secret for this record");
  const fresh = disclose(newRecordCommitment);
  assert(fresh == commit(incomingGeneticSecret()), "You must hold the secret behind the new commitment");
  assertUnused(fresh);
  originOf.insert(fresh, origin);
  headOf.insert(origin, fresh);
  rotationSeq.increment(1);
  lastRecoveredOrigin = origin;
  lastRotatedTo = fresh;
}

/** Replace a recovery commitment, gated by the current recovery secret. */
export circuit replaceRecoveryCommitment(recordCommitment: Bytes<32>, newRecoveryCommitment: Bytes<32>): [] {
  const origin = disclose(recordCommitment);
  assert(recoveryOf.member(origin), "Recovery is only for an anchored origin record");
  const current = recoveryOf.lookup(origin);
  assert(current == recoveryCommit(recoverySecret()), "That is not the recovery secret for this record");
  const next = disclose(newRecoveryCommitment);
  assertUsableRecovery(next);
  assert(next != current, "The new recovery commitment must differ");
  recoveryOf.insert(origin, next);
}

// ─────────────────────────────────────────────────────────────── licences

/**
 * Issue a licence against the caller's own live record. Starts PENDING.
 * THE LICENSEE generates the licence secret and hands over only
 * licenseCommit(secret, issuer record). The contract cannot check this.
 */
export circuit issueLicense(licenseCommitment: Bytes<32>): [] {
  const me = liveSelf();
  const lc = disclose(licenseCommitment);
  assert(lc != default<Bytes<32>>, "The licence commitment cannot be empty");
  const k = licenseKey(lc, me);
  assert(!licenseStatusOf.member(k), "License already exists");
  licenseStatusOf.insert(k, LicenseState.PENDING);
}

/**
 * The licensee accepts, proving the licence secret (a witness). Activation publishes
 * the licence and its issuer and places the leaf; the licensee supplies no path.
 */
export circuit countersignLicense(recordCommitment: Bytes<32>): [] {
  const rc = disclose(recordCommitment);
  const lc = licenseCommit(licenseSecret(), rc);
  const k = disclose(licenseKey(lc, rc));
  assert(licenseStatusOf.member(k), "No such license against that record");
  assert(licenseStatusOf.lookup(k) == LicenseState.PENDING, "License is not pending");
  licenseStatusOf.insert(k, LicenseState.ACTIVE);
  const slot = nextLicenseSlot.read();
  activeLicenses.insertIndex(k, slot);
  licenseSlotOf.insert(k, slot);
  nextLicenseSlot.increment(1);
  lastActivatedLicense = disclose(lc);
  lastActivatedRecord = rc;
}

/**
 * The holder proposes moving the licence. The incoming party generates their own
 * secret and hands over licenseCommit(theirSecret, issuer record). A commitment built
 * any other way gives them a licence they cannot open — it cannot give them anyone
 * else's, because the tree leaf includes the issuer.
 */
export circuit proposeTransfer(recordCommitment: Bytes<32>, newLicenseCommitment: Bytes<32>): [] {
  const rc = disclose(recordCommitment);
  const k = disclose(licenseKey(licenseCommit(licenseSecret(), rc), rc));
  assert(licenseStatusOf.member(k), "No such license against that record");
  assert(licenseStatusOf.lookup(k) == LicenseState.ACTIVE, "Only an active license can be transferred");
  assert(!pendingTransferOf.member(k), "A transfer is already proposed for this license");
  const nlc = disclose(newLicenseCommitment);
  assert(nlc != default<Bytes<32>>, "The incoming licence commitment cannot be empty");
  assert(!licenseStatusOf.member(licenseKey(nlc, rc)), "That licence commitment is already in use");
  transferSeq.increment(1);
  pendingTransferOf.insert(k, nlc);
}

/**
 * The issuer, or whoever their identity now lives under, approves the transfer to the
 * party they name. The old leaf is replaced in place by the new one, and older roots
 * are dropped so the outgoing party's rights end at once.
 */
export circuit approveTransfer(licenseCommitment: Bytes<32>, issuingRecord: Bytes<32>, expectedNewLicense: Bytes<32>): [] {
  const me = liveSelf();
  const rc = disclose(issuingRecord);
  assertSameIdentity(me, rc);
  const k = licenseKey(disclose(licenseCommitment), rc);
  assert(pendingTransferOf.member(k), "No transfer proposed for this license");
  const nlc = pendingTransferOf.lookup(k);
  assert(nlc == disclose(expectedNewLicense), "The pending recipient is not the one you approved");
  const nk = licenseKey(nlc, rc);
  assert(!licenseStatusOf.member(nk), "That licence commitment is already in use");
  const slot = licenseSlotOf.lookup(k);
  licenseStatusOf.remove(k);
  pendingTransferOf.remove(k);
  licenseSlotOf.remove(k);
  licenseStatusOf.insert(nk, LicenseState.ACTIVE);
  licenseSlotOf.insert(nk, slot);
  activeLicenses.insertIndex(nk, slot);
  activeLicenses.resetHistory();
  transferSeq.increment(1);
}

/** The holder withdraws their own proposal. Proposals do not expire. */
export circuit withdrawTransfer(recordCommitment: Bytes<32>): [] {
  const rc = disclose(recordCommitment);
  const k = disclose(licenseKey(licenseCommit(licenseSecret(), rc), rc));
  assert(pendingTransferOf.member(k), "No transfer proposed for this license");
  pendingTransferOf.remove(k);
  transferSeq.increment(1);
}

/**
 * The issuer, or its successor across any number of moves, revokes. Needs no tree
 * path and reads nothing the licensee can change, so it cannot be starved: it used to
 * need a path against the current root and read whether a transfer was pending, and a
 * licensee toggling either each block kept every revocation from landing.
 */
export circuit revokeLicense(licenseCommitment: Bytes<32>, issuingRecord: Bytes<32>): [] {
  const me = liveSelf();
  const rc = disclose(issuingRecord);
  assertSameIdentity(me, rc);
  const k = licenseKey(disclose(licenseCommitment), rc);
  assert(licenseStatusOf.member(k), "No such license");
  const wasActive = licenseStatusOf.lookup(k) == LicenseState.ACTIVE;
  licenseStatusOf.remove(k);
  pendingTransferOf.remove(k);
  if (wasActive) {
    activeLicenses.insertIndexDefault(licenseSlotOf.lookup(k));
    licenseSlotOf.remove(k);
    // Drop every older root, so a path proved before this revocation stops working.
    activeLicenses.resetHistory();
  }
}

/**
 * A licensee proves to ONE verifier that they hold a live licence from ONE record.
 * All inputs are witnesses. Publishes presentationTag(record, challenge) and the root
 * it proved against, and nothing that names the licence, the record or the position.
 * Presentations survive new activations; a revocation or transfer anywhere drops
 * older roots, so a presentation in flight across one must be re-proved.
 */
export circuit proveLicense(): [] {
  const record = licenseRecord();
  const challenge = presentationChallenge();
  assert(disclose(challenge != default<Bytes<32>>), "A presentation needs the verifier's challenge");
  const path = licensePath();
  const leaf = licenseKey(licenseCommit(licenseSecret(), record), record);
  assert(disclose(path.leaf == leaf), "No live licence for that secret");
  assert(activeLicenses.checkRoot(disclose(merkleTreePathRoot<24, Bytes<32>>(path))),
         "No live licence for that secret, or the path is stale");
  presentationSeq.increment(1);
  lastPresentation = disclose(presentationTag(record, challenge));
}

/**
 * Public status lookup. NAMES THE LICENCE AND ITS ISSUER, and repeated calls link. Use
 * proveLicense to show a stranger a licence.
 */
export circuit licenseStatus(licenseCommitment: Bytes<32>, issuingRecord: Bytes<32>): LicenseState {
  const k = licenseKey(disclose(licenseCommitment), disclose(issuingRecord));
  assert(licenseStatusOf.member(k), "No such live license");
  return licenseStatusOf.lookup(k);
}
